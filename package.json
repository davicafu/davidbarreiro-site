{
  "name": "davicafu-tailwind-d3-animated",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i ./src/input.css -o ./dist/styles.css --minify",
    "build:d3": "node ./scripts/build-d3-lite.mjs",
    "sync:astro-public": "node ./scripts/sync-astro-public.mjs",
    "dev": "astro dev",
    "dev:css": "tailwindcss -c tailwind.config.js -i ./src/input.css -o ./dist/styles.css --watch",
    "predev": "corepack pnpm run sync:astro-public",
    "build": "corepack pnpm run sync:astro-public && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint \"**/*.{js,mjs}\" --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern public --ignore-pattern _site",
    "format": "prettier --write \"**/*.{astro,css,html,js,json,md,mjs,ts,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{astro,css,html,js,json,md,mjs,ts,yml,yaml}\""
  },
  "dependencies": {
    "@sparticuz/chromium": "^138.0.2",
    "puppeteer-core": "^24.19.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^6.3.7",
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-color": "^3.1.0",
    "d3-ease": "^3.0.1",
    "d3-format": "^3.1.2",
    "d3-hierarchy": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.36.0",
    "eslint-plugin-html": "^8.1.3",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3"
  }
}
