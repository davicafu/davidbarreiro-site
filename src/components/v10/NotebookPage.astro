---
/**
 * Redesign "Data notebook" (routes /v10/ and /es/v10/).
 * The portfolio as an interactive data notebook: every section is a cell with an
 * input (a short query or call) and its output (DAG, result sets, charts). Cells
 * "run" as they scroll into view and can be re-run. Standalone page: it does not
 * load the main site's JS or Tailwind, and every output is readable without JS.
 */
import SeoHead from '../common/SeoHead.astro';
import { getAlternateLinks, getLocaleMetadata, type Locale } from '../../lib/locale';
import { getPreviewContent } from '../v3/previewContent';
import '../../styles/v10.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const seo = getLocaleMetadata(locale);
const c = getPreviewContent(locale);

const t = {
  en: {
    home: '/v10/',
    file: 'portfolio.nb',
    sections: 'Sections',
    outline: 'Outline',
    nav: { method: 'Method', work: 'Experience', projects: 'Projects', skills: 'Skills', contact: 'Contact' },
    langLabel: 'Language',
    skip: 'Skip to content',
    kernelIdle: 'Kernel ready',
    kernelBusy: 'Running…',
    ran: 'ran in {ms} ms',
    running: 'running…',
    rerun: 'Run cell again',
    role: 'Senior Software Engineer',
    positioning: 'Data platforms & Go backend',
    headline: 'I design real-time data platforms and build the Go backends that hold them up.',
    lede: (years: number) =>
      `${years} years taking systems to production with Kafka, Spark, ClickHouse, Go and Java: from the first event to the dashboard that reads it.`,
    contact: 'Get in touch',
    cv: 'Download CV',
    cvOptions: {
      onePage: ['One page', 'Compact summary'],
      professional: ['Professional', 'Full detail, minimal layout'],
      jsonresume: ['JSON Resume', 'Standard format']
    },
    describe: {
      years: 'years in production',
      since: (y: number) => `since ${y}`,
      roles: 'roles',
