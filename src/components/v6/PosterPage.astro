---
/**
 * "Editorial" theme (routes /editorial/ and /es/editorial/).
 * International Typographic Style: a strict grid, huge numerals, flat colour fields.
 * Section order and headings match the main site (src/pages/index.astro, src/js/i18n.js);
 * the poster identity comes from the visuals, not from renamed sections. Standalone page:
 * it does not load the main site's JS or Tailwind.
 */
import SeoHead from '../common/SeoHead.astro';
import ThemeSwitch from '../v3/ThemeSwitch.astro';
import { getResume } from '../../data/resume';
import { getAlternateLinks, getLocaleMetadata, type Locale } from '../../lib/locale';
import { getPreviewContent } from '../v3/previewContent';
import '../../styles/v6.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const seo = getLocaleMetadata(locale);
const c = getPreviewContent(locale);
const basics = getResume(locale).basics;

// Main-site strings: EN from src/pages/index.astro, ES from src/js/i18n.js.
const t = {
  en: {
    home: '/editorial/',
    sections: 'Sections',
    nav: { portfolio: 'Portfolio', experience: 'Experience', skills: 'Skills', contact: 'Contact' },
    langLabel: 'Language',
    skip: 'Skip to content',
    contact: 'Contact',
    cv: 'Download CV',
    facts: { label: 'At a glance', now: 'Now', certified: 'Certified', projects: 'Personal projects' },
    moreSummary: 'Read the full summary',
    lessSummary: 'Hide the full summary',
    capabilitiesTitle: 'Capabilities',
    portfolioKicker: 'Portfolio',
    portfolioTitle: 'Personal projects & technical work',
    portfolioIntro: 'Filter by topic; a project shows if it has any selected topic.',
    filterLabel: 'Topics',
    filterAll: 'All',
    showing: (n: number, total: number) => `${n} of ${total} projects`,
    clear: 'Clear',
    empty: 'No projects match the selected filters.',
    repo: 'Repository',
    systemKicker: 'System Design',
    systemTitle: 'How I design data platforms',
    systemIntro: 'Seven stages, from the systems that produce data to the people who use it. Select one.',
    tech: 'Tech',
    timelineKicker: 'Timeline',
    timelineTitle: 'Professional experience',
    timelineIntro: 'Every role since 2014. Open one to read what I built.',
    highlights: 'Highlights',
    educationTitle: 'Education',
    skillsKicker: 'Skills',
    skillsTitle: 'Stack technology',
    skillsIntro: 'Select a category to view its keywords and level.',
    levels: { Advanced: 2, Intermediate: 1, Expert: 3 } as Record<string, number>,
    certified: 'Certified',
    certsTitle: 'Certifications',
    contactKicker: 'Contact',
    contactTitle: "Let's talk",
    contactText:
      "If something here is useful to you, or you'd like to talk about any of it, send me a message.",
    footerRole: 'Software Engineer'
  },
  es: {
    home: '/es/editorial/',
    sections: 'Secciones',
    nav: { portfolio: 'Proyectos', experience: 'Experiencia', skills: 'Habilidades', contact: 'Contacto' },
    langLabel: 'Idioma',
    skip: 'Saltar al contenido',
    contact: 'Contacto',
    cv: 'Descargar CV',
    facts: { label: 'En resumen', now: 'Ahora', certified: 'Certificaciones', projects: 'Proyectos personales' },
    moreSummary: 'Leer el resumen completo',
    lessSummary: 'Ocultar el resumen completo',
    capabilitiesTitle: 'Capacidades',
    portfolioKicker: 'Portfolio',
    portfolioTitle: 'Proyectos personales y trabajo técnico',
    portfolioIntro: 'Filtra por tema; un proyecto aparece si tiene alguno de los temas elegidos.',
    filterLabel: 'Temas',
    filterAll: 'Todos',
    showing: (n: number, total: number) => `${n} de ${total} proyectos`,
    clear: 'Limpiar',
    empty: 'No hay proyectos que coincidan con los filtros seleccionados.',
    repo: 'Repositorio',
    systemKicker: 'Diseño de Sistemas',
    systemTitle: 'Diseño de plataformas de datos',
    systemIntro: 'Siete etapas, de los sistemas que producen datos a las personas que los usan. Elige una.',
    tech: 'Tecnologías',
    timelineKicker: 'Trayectoria',
    timelineTitle: 'Experiencia profesional',
    timelineIntro: 'Cada puesto desde 2014. Abre uno para leer qué construí.',
    highlights: 'Logros',
    educationTitle: 'Formación',
    skillsKicker: 'Habilidades',
    skillsTitle: 'Stack tecnológico',
    skillsIntro: 'Selecciona una categoría para ver sus tecnologías y nivel.',
    levels: { Avanzado: 2, Intermedio: 1, Experto: 3 } as Record<string, number>,
    certified: 'Certificado',
    certsTitle: 'Certificaciones',
    contactKicker: 'Contacto',
    contactTitle: '¿Hablamos?',
    contactText:
      'Si algo de lo que hay aquí te resulta útil o quieres comentarlo, escríbeme.',
    footerRole: 'Ingeniero de Software'
  }
}[locale];

const nowYear = new Date().getFullYear();
const certificates = [...c.certificateDetails].sort((a, b) => b.date.localeCompare(a.date));
const work = [...c.work].sort((a, b) => b.start - a.start);
const education = [...c.education].sort((a, b) => b.start - a.start);

// Flat poster colours for project tiles and system-design stages: wide enough that no two
// tiles or stages share a colour.
const FIELDS = ['cobalt', 'ochre', 'ink', 'green', 'red', 'violet', 'pink', 'sky'];

// Brand glyphs (Simple Icons paths, 24×24), drawn in currentColor next to the link text.
const ICONS = {
  github:
    'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z'
};

const tagCounts = new Map<string, number>();
c.projects.forEach((project) =>
  project.allTags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1))
);
const allTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag]) => tag);

const levelDots = (level: string) => t.levels[level] ?? 0;
const pad = (n: number) => String(n).padStart(2, '0');
// Desktop track list for the stage row: the open stage takes the wide track. poster.ts
// rebuilds the same list when another stage opens.
const stageColumns = (open: number) =>
  c.stages.map((_, index) => (index === open ? 'var(--open-w)' : '1fr')).join(' ');
const summary = basics.summary.split(/\n\s*\n/).map((paragraph) => paragraph.trim()).filter(Boolean);

// Hero facts, all derived from the resume. "Now": the current employer plus the shared
// pipeline every theme shows (e.g. MySQL → Kafka → ClickHouse).
const currentJob = c.work[0];
const nowCaption = c.nowPipeline.length > 0 ? c.nowPipeline.join(' → ') : (currentJob?.role ?? '');
// "Certified": only credentials with a verification URL count.
const verified = c.certificateDetails.filter((cert) => cert.url);
const issuers = [...new Set(verified.map((cert) => cert.issuer).filter(Boolean))];
---

<html lang={locale}>
  <head>
    <SeoHead
      title={seo.title}
      description={seo.description}
      canonical={seo.canonical}
      ogLocale={seo.ogLocale}
      ogLocaleAlternate={seo.ogLocaleAlternate}
      ogTitle={seo.ogTitle}
      ogDescription={seo.ogDescription}
      alternates={getAlternateLinks()}
      noindex
    />
    <link rel="preload" href="/assets/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f2efe6" />
    <script is:inline>
      document.documentElement.classList.add('sp-js');
    </script>
  </head>
  <body class="sp">
    <a class="sp-skip" href="#main">{t.skip}</a>

    <header class="sp-bar">
      <a class="sp-brand" href={t.home} aria-label="David Barreiro">
        <span class="sp-brand-mark" aria-hidden="true"><i></i><i></i></span>
        <span class="sp-brand-text">David Barreiro</span>
      </a>
      <nav class="sp-nav" aria-label={t.sections}>
        <a href="#portfolio">{t.nav.portfolio}</a>
        <a href="#experience">{t.nav.experience}</a>
        <a href="#skills">{t.nav.skills}</a>
      </nav>
      <div class="sp-bar-end">
        <ThemeSwitch locale={locale} current="poster" />
        <div class="sp-lang" role="group" aria-label={t.langLabel}>
          <a href="/editorial/" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
          <a href="/es/editorial/" hreflang="es" aria-current={locale === 'es' ? 'page' : undefined}>ES</a>
        </div>
        <a class="sp-btn sp-btn-sm" href="#contact">{t.nav.contact}</a>
      </div>
    </header>

    <main id="main">
      <!-- ============ HERO POSTER ============ -->
      <!-- The name is the poster's dominant block; the facts below it are flat colour fields. -->
      <section class="sp-hero" aria-labelledby="sp-title">
        <div class="sp-hero-deco" aria-hidden="true">
          <span class="sp-hero-disc"></span>
          <span class="sp-hero-rule"></span>
        </div>
        <p class="sp-role">{basics.label}</p>
        <h1 id="sp-title" class="sp-name">
          <span>David</span>
          <span>Barreiro</span>
        </h1>
        <span class="sp-hero-photo">
          <img src="/assets/profile/avatar-224.avif" alt="" width="224" height="224" />
        </span>
        <div class="sp-hero-copy">
          <p class="sp-deck">{c.copy.summary}</p>
          <div class="sp-hero-cta">
          <div class="sp-actions">
            <a class="sp-btn" href={`mailto:${c.email}`}>{t.contact}</a>
            <a class="sp-btn sp-btn-line" href={c.cvUrl} target="_blank" rel="noopener noreferrer">{t.cv}</a>
          </div>
          <p class="sp-links">
            <a class="sp-social" href={c.githubUrl} target="_blank" rel="noopener noreferrer">
              <svg class="sp-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                <path d={ICONS.github} />
              </svg>
              GitHub
            </a>
            <a class="sp-social" href={c.linkedinUrl} target="_blank" rel="noopener noreferrer">
              <svg class="sp-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                <path d={ICONS.linkedin} />
              </svg>
              LinkedIn
            </a>
          </p>
          </div>
          <details class="sp-more">
            <summary>
              <span class="sp-more-open">{t.moreSummary}</span>
              <span class="sp-more-close">{t.lessSummary}</span>
            </summary>
            <div class="sp-more-body">
              {summary.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </details>
        </div>

        <ul class="sp-facts" aria-label={t.facts.label}>
          {
            currentJob && (
              <li class="sp-fact sp-fact-now sp-f-red">
                <span class="sp-fact-label">{t.facts.now}</span>
                <span class="sp-fact-value sp-fact-word">{currentJob.organisation}</span>
                <span class="sp-fact-cap">{nowCaption}</span>
              </li>
            )
          }
          <li class="sp-fact sp-f-cobalt">
            <a class="sp-fact-link" href="#skills">
              <span class="sp-fact-label">{t.facts.certified}</span>
              <span class="sp-fact-value">{verified.length}</span>
              <span class="sp-fact-cap">{issuers.join(' · ')}</span>
            </a>
          </li>
          <li class="sp-fact sp-f-ochre">
            <a class="sp-fact-link" href="#portfolio">
              <span class="sp-fact-label">{t.portfolioKicker}</span>
              <span class="sp-fact-value">{c.projects.length}</span>
              <span class="sp-fact-cap">{t.facts.projects}</span>
            </a>
          </li>
        </ul>
      </section>

      <!-- ============ CAPABILITIES ============ -->
      <section class="sp-caps" id="capabilities" aria-labelledby="capabilities-title" data-reveal>
        <h2 id="capabilities-title" class="sp-sr">{t.capabilitiesTitle}</h2>
        <ul class="sp-caps-grid">
          {
            c.capabilities.map((card, index) => (
              <li class:list={['sp-cap', `sp-f-${['red', 'cobalt', 'ochre'][index]}`]}>
                <p class="sp-cap-label">{card.label}</p>
                <h3>{card.heading}</h3>
                <ul class="sp-cap-proof">
                  {card.proof.map((item) => (
                    <li>
                      {item.text}
                      <span>{item.where}</span>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- ============ PORTFOLIO ============ -->
      <section class="sp-section" id="portfolio" aria-labelledby="portfolio-title" data-projects data-reveal>
        <header class="sp-head">
          <span class="sp-head-num" aria-hidden="true">01</span>
          <div class="sp-head-title">
            <p class="sp-kicker">{t.portfolioKicker}</p>
            <h2 id="portfolio-title">{t.portfolioTitle}</h2>
          </div>
          <p class="sp-head-intro">{t.portfolioIntro}</p>
        </header>
        <div class="sp-filter" role="group" aria-label={t.filterLabel}>
          <button type="button" class="sp-chip" data-tag="" aria-pressed="true">{t.filterAll}</button>
          {
            allTags.map((tag) => (
              <button type="button" class="sp-chip" data-tag={tag} aria-pressed="false">
                {tag}
              </button>
            ))
          }
        </div>
        <p class="sp-filter-status">
          <span data-count>{t.showing(c.projects.length, c.projects.length)}</span>
          <button type="button" class="sp-clear" data-clear hidden>{t.clear}</button>
        </p>
        <ol class="sp-tiles">
          {
            c.projects.map((project, index) => (
              <li
                class:list={['sp-tile', `sp-f-${FIELDS[index % FIELDS.length]}`]}
                data-tags={JSON.stringify(project.allTags)}
              >
                <span class="sp-tile-num" aria-hidden="true">
                  {pad(index + 1)}
                </span>
                <div class="sp-tile-body">
                  <h3>
                    {project.url ? (
                      <a href={project.url} target="_blank" rel="noopener noreferrer">
                        {project.name}
                        <span class="sp-arrow" aria-hidden="true">
                          ↗
                        </span>
                        <span class="sp-sr">({t.repo})</span>
                      </a>
                    ) : (
                      project.name
                    )}
                  </h3>
                  <p>{project.oneLiner}</p>
                  <p class="sp-tile-tags">{project.allTags.join(' · ')}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="sp-empty" data-empty hidden>{t.empty}</p>
      </section>

      <!-- ============ SYSTEM DESIGN ============ -->
      <section class="sp-section" id="system-design" aria-labelledby="system-title" data-reveal>
        <header class="sp-head">
          <span class="sp-head-num" aria-hidden="true">02</span>
          <div class="sp-head-title">
            <p class="sp-kicker">{t.systemKicker}</p>
            <h2 id="system-title">{t.systemTitle}</h2>
          </div>
          <p class="sp-head-intro">{t.systemIntro}</p>
        </header>
        <!-- Stages expand in place: the open one widens within the row on desktop and unfolds
             below its header on narrow screens. One is always open; the first by default. -->
        <ol class="sp-blocks" data-method style={`--cols: ${stageColumns(0)}`}>
          {
            c.stages.map((stage, index) => (
              <li class:list={['sp-block', `sp-f-${FIELDS[index % FIELDS.length]}`, { 'is-open': index === 0 }]}>
                <h3 class="sp-block-head">
                  <button
                    type="button"
                    class="sp-block-btn"
                    id={`sp-stage-btn-${index}`}
                    aria-expanded={index === 0 ? 'true' : 'false'}
                    aria-controls={`sp-stage-${index}`}
                    data-stage={index}
                  >
                    <span class="sp-block-num" aria-hidden="true">
                      {pad(index + 1)}
                    </span>
                    <span class="sp-block-name">{stage.name}</span>
                  </button>
                </h3>
                <div
                  class="sp-block-body"
                  id={`sp-stage-${index}`}
                  role="region"
                  aria-labelledby={`sp-stage-btn-${index}`}
                  hidden={index !== 0}
                >
                  <p class="sp-block-detail">{stage.detail}</p>
                  <p class="sp-block-tech">
                    <span>{t.tech}</span>
                    <span>{stage.tech.join(' · ')}</span>
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- ============ EXPERIENCE ============ -->
      <section class="sp-section" id="experience" aria-labelledby="experience-title" data-reveal>
        <header class="sp-head">
          <span class="sp-head-num" aria-hidden="true">03</span>
          <div class="sp-head-title">
            <p class="sp-kicker">{t.timelineKicker}</p>
            <h2 id="experience-title">{t.timelineTitle}</h2>
          </div>
          <p class="sp-head-intro">{t.timelineIntro}</p>
        </header>
        <ol class="sp-index">
          {
            work.map((job, index) => (
              <li>
                <details open={index === 0}>
                  <summary>
                    <span class="sp-index-year">{job.start}</span>
                    <span class="sp-index-main">
                      <span class="sp-index-org">{job.organisation}</span>
                      <span class="sp-index-role">
                        {job.role} · {job.period}
                      </span>
                    </span>
                    <span class="sp-index-toggle" aria-hidden="true" />
                  </summary>
                  <div class="sp-index-body">
                    {job.summary && <p class="sp-index-summary">{job.summary}</p>}
                    {job.highlights.length > 0 && (
                      <div>
                        <h3>{t.highlights}</h3>
                        <ul>
                          {job.highlights.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </div>
                    )}
                    {job.tech.length > 0 && (
                      <p class="sp-tags">
                        {job.tech.map((tech) => (
                          <span>{tech}</span>
                        ))}
                      </p>
                    )}
                  </div>
                </details>
              </li>
            ))
          }
        </ol>

        <div class="sp-edu">
          <h3>{t.educationTitle}</h3>
          <ul>
            {
              education.map((item) => (
                <li>
                  <span class="sp-edu-years">{item.period}</span>
                  <span class="sp-edu-role">{item.role}</span>
                  <span class="sp-edu-org">{item.organisation}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ============ SKILLS ============ -->
      <section class="sp-section" id="skills" aria-labelledby="skills-title" data-reveal>
        <header class="sp-head">
          <span class="sp-head-num" aria-hidden="true">04</span>
          <div class="sp-head-title">
            <p class="sp-kicker">{t.skillsKicker}</p>
            <h2 id="skills-title">{t.skillsTitle}</h2>
          </div>
          <p class="sp-head-intro">{t.skillsIntro}</p>
        </header>
        <div class="sp-skills">
          <div class="sp-areas" role="tablist" aria-label={t.skillsTitle} aria-orientation="vertical">
            {
              c.skillGroups.map((group, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`sp-tab-${index}`}
                  aria-controls={`sp-panel-${index}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  tabindex={index === 0 ? 0 : -1}
                >
                  <span class="sp-area-num">{pad(index + 1)}</span>
                  <span>{group.name}</span>
                  <span class="sp-area-count">{group.keywords.length}</span>
                </button>
              ))
            }
          </div>
          <div class="sp-panels">
            {
              c.skillGroups.map((group, index) => (
                <div
                  class="sp-panel"
                  role="tabpanel"
                  id={`sp-panel-${index}`}
                  aria-labelledby={`sp-tab-${index}`}
                  hidden={index !== 0}
                >
                  <ul class="sp-skill-grid">
                    {group.keywords.map((skill) => (
                      <li>
                        {skill.logo ? (
                          <img src={skill.logo} alt="" width="40" height="40" loading="lazy" />
                        ) : (
                          <span class="sp-skill-ph" aria-hidden="true" />
                        )}
                        <p class="sp-skill-name">{skill.name}</p>
                        <p class="sp-skill-level">
                          <span class="sp-meter" aria-hidden="true">
                            {[1, 2, 3].map((n) => (
                              <i class:list={{ on: n <= levelDots(skill.level) }} />
                            ))}
                          </span>
                          {skill.level}
                        </p>
                        {skill.certifications.map((cert) => (
                          <a class="sp-cert" href={cert.url} target="_blank" rel="noopener noreferrer">
                            {t.certified} · {cert.issuer}
                          </a>
                        ))}
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
        <h3 class="sp-certs-title">{t.certsTitle}</h3>
        <ol class="sp-certs">
          {
            certificates.map((cert) => (
              <li>
                <span class="sp-certs-year">{cert.date.slice(0, 4)}</span>
                {cert.url ? (
                  <a href={cert.url} target="_blank" rel="noopener noreferrer">
                    {cert.name}
                  </a>
                ) : (
                  <span>{cert.name}</span>
                )}
                <span class="sp-certs-issuer">{cert.issuer}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- ============ CONTACT POSTER ============ -->
      <section class="sp-contact" id="contact" aria-labelledby="contact-title" data-reveal>
        <div class="sp-contact-grid">
          <span class="sp-contact-num" aria-hidden="true">05</span>
          <div class="sp-contact-head">
            <p class="sp-contact-kicker">{t.contactKicker}</p>
            <h2 id="contact-title">{t.contactTitle}</h2>
          </div>
          <p class="sp-contact-text">{t.contactText}</p>
          <div class="sp-contact-actions">
            <a class="sp-btn sp-btn-invert" href={`mailto:${c.email}`}>{c.email}</a>
            <a class="sp-btn sp-btn-ghost" href={c.cvUrl} target="_blank" rel="noopener noreferrer">{t.cv}</a>
          </div>
          <p class="sp-links sp-links-invert">
            <a class="sp-social" href={c.linkedinUrl} target="_blank" rel="noopener noreferrer">
              <svg class="sp-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                <path d={ICONS.linkedin} />
              </svg>
              LinkedIn
            </a>
            <a class="sp-social" href={c.githubUrl} target="_blank" rel="noopener noreferrer">
              <svg class="sp-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                <path d={ICONS.github} />
              </svg>
              GitHub
            </a>
          </p>
          <div class="sp-contact-disc" aria-hidden="true"></div>
        </div>
      </section>
    </main>

    <footer class="sp-footer">
      <p>© {nowYear} {basics.name} · {t.footerRole}</p>
      <p class="sp-footer-links">
        <a href={`mailto:${c.email}`}>Email</a>
        <a class="sp-social" href={c.githubUrl} target="_blank" rel="noopener noreferrer">
          <svg class="sp-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
            <path d={ICONS.github} />
          </svg>
          GitHub
        </a>
        <a class="sp-social" href={c.linkedinUrl} target="_blank" rel="noopener noreferrer">
          <svg class="sp-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
            <path d={ICONS.linkedin} />
          </svg>
          LinkedIn
        </a>
      </p>
    </footer>

    <script
      is:inline
      type="application/json"
      id="sp-data"
      set:html={JSON.stringify({
        labels: {
          showing: t.showing(0, 0).replace(/\d+/g, '{n}')
        }
      })}
    />
    <script>
      import './poster.ts';
    </script>
  </body>
</html>
