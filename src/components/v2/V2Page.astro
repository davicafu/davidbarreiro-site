---
/**
 * Improved variant of the portfolio (routes /v2/ and /es/v2/).
 * It keeps the element IDs the client JS in src/js/ renders into, so every
 * interactive feature works unchanged, and avoids the IDs that
 * applyStaticTranslations() overwrites wherever this page's copy differs.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getResume, getSocialLinks } from '../../data/resume';
import { getAlternateLinks, getLocaleMetadata, type Locale } from '../../lib/locale';
import '../../styles/v2.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const seo = getLocaleMetadata(locale);
const resume = getResume(locale);
const { githubUrl, linkedinUrl } = getSocialLinks(resume.basics);
const email = resume.basics.email;

const copy = {
  en: {
    home: '/v2/',
    languageSelector: 'Language selector',
    nav: {
      experience: 'Experience',
      method: 'Method',
      projects: 'Projects',
      skills: 'Skills',
      contact: 'Contact'
    },
    role: 'Senior Software Engineer · Data platforms & Go backend',
    summary:
      'I design and build real-time data platforms (Kafka, Spark, ClickHouse) and the Go and Java backends around them, with an architecture that stays maintainable as it grows.',
    contact: 'Get in touch',
    downloadCv: 'Download CV',
    cvOptions: [
      { href: '/cv-one-page.pdf', label: 'One page', note: 'Compact summary' },
      { href: '/cv-professional.pdf', label: 'Professional', note: 'Full detail, minimal layout' },
      { href: '/cv-jsonresume.pdf', label: 'JSON Resume', note: 'Standard format' }
    ],
    metrics: { experience: 'Years of experience', skills: 'Advanced skills', focus: 'Focus' },
    focusValue: 'Data platforms · System design · Cloud-native',
    experienceTitle: 'Experience',
    methodTitle: 'How I design data platforms',
    methodIntro: 'The seven stages I work through, from data sources to the people who consume the data.',
    projectsTitle: 'Projects',
    capabilitiesTitle: 'What I do',
    capabilities: [
      {
        label: 'Data platforms',
        heading: 'Batch and streaming pipelines',
        description:
          'Kafka, Spark and ClickHouse pipelines that move high volumes with low latency and scale with the load.'
      },
      {
        label: 'Backend & architecture',
        heading: 'Go and Java services that last',
        description:
          'Hexagonal and domain-driven design: decoupled, testable services and event-driven integration.'
      },
      {
        label: 'Platform',
        heading: 'Reliable to run',
        description:
          'Kubernetes, CI/CD automation and observability, so systems stay available and easy to operate.'
      }
    ],
    skillsTitle: 'Skills',
    skillsTip: 'Pick a category to see its technologies, or click a bubble in the chart.',
    ctaBandTitle: 'Want the short version?',
    ctaBandText: 'Download the one-page CV or write to me directly.',
    contactTitle: "Let's build something with data",
    contactText:
      'Open to data engineering, streaming platforms and software architecture roles and projects.',
    footerRole: 'Senior Software Engineer'
  },
  es: {
    home: '/es/v2/',
    languageSelector: 'Selector de idioma',
    nav: {
      experience: 'Experiencia',
      method: 'Método',
      projects: 'Proyectos',
      skills: 'Skills',
      contact: 'Contacto'
    },
    role: 'Ingeniero de Software Senior · Plataformas de datos y backend en Go',
    summary:
      'Diseño y construyo plataformas de datos en tiempo real (Kafka, Spark, ClickHouse) y los backends en Go y Java que las rodean, con una arquitectura que sigue siendo mantenible a medida que crece.',
    contact: 'Contactar',
    downloadCv: 'Descargar CV',
    cvOptions: [
      { href: '/cv-one-page.pdf', label: 'Una página', note: 'Resumen compacto (en inglés)' },
      { href: '/cv-professional.pdf', label: 'Profesional', note: 'Completo, diseño sobrio (en inglés)' },
      { href: '/cv-jsonresume.pdf', label: 'JSON Resume', note: 'Formato estándar (en inglés)' }
    ],
    metrics: { experience: 'Años de experiencia', skills: 'Skills avanzadas', focus: 'Enfoque' },
    focusValue: 'Plataformas de datos · Diseño de sistemas · Cloud-native',
    experienceTitle: 'Experiencia',
    methodTitle: 'Cómo diseño plataformas de datos',
    methodIntro: 'Las siete etapas que recorro, desde las fuentes de datos hasta quien los consume.',
    projectsTitle: 'Proyectos',
    capabilitiesTitle: 'Qué hago',
    capabilities: [
      {
        label: 'Plataformas de datos',
        heading: 'Pipelines batch y streaming',
        description:
          'Pipelines con Kafka, Spark y ClickHouse que mueven grandes volúmenes con baja latencia y escalan con la carga.'
      },
      {
        label: 'Backend y arquitectura',
        heading: 'Servicios en Go y Java que duran',
        description:
          'Diseño hexagonal y orientado al dominio: servicios desacoplados, testeables e integración por eventos.'
      },
      {
        label: 'Plataforma',
        heading: 'Fiables de operar',
        description:
          'Kubernetes, automatización CI/CD y observabilidad, para que los sistemas sigan disponibles y sean fáciles de operar.'
      }
    ],
    skillsTitle: 'Skills',
    skillsTip: 'Elige una categoría para ver sus tecnologías, o pulsa una burbuja del gráfico.',
    ctaBandTitle: '¿Prefieres la versión corta?',
    ctaBandText: 'Descarga el CV de una página o escríbeme directamente.',
    contactTitle: 'Construyamos algo con datos',
    contactText:
      'Abierto a puestos y proyectos de ingeniería de datos, plataformas streaming y arquitectura de software.',
    footerRole: 'Ingeniero de Software Senior'
  }
}[locale];

const [firstName, ...rest] = (resume.basics.name || 'David Barreiro Salgueiro').split(' ');
const surname = rest.join(' ');
const projects = Array.isArray(resume.portfolio) ? resume.portfolio.slice(0, 8) : [];
const repoUrl = (project: (typeof projects)[number]) =>
  'url' in project && typeof project.url === 'string' && /^https?:\/\//i.test(project.url) ? project.url : '';
---

<BaseLayout
  lang={locale}
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  ogLocale={seo.ogLocale}
  ogLocaleAlternate={seo.ogLocaleAlternate}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  alternates={getAlternateLinks()}
  resumeData={resume}
  noindex
>
  <div class="v2">
    <a class="v2-skip" href="#main">{locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>

    <header class="v2-bar">
      <div class="v2-bar-inner">
        <a class="v2-wordmark" href={copy.home}>David Barreiro</a>
        <nav class="v2-nav" aria-label={locale === 'es' ? 'Secciones' : 'Sections'}>
          <a href="#experience">{copy.nav.experience}</a>
          <a href="#method">{copy.nav.method}</a>
          <a href="#portfolio">{copy.nav.projects}</a>
          <a href="#skills">{copy.nav.skills}</a>
        </nav>
        <div class="v2-bar-actions">
          <div
            class:list={['lang-toggle', { 'is-es': locale === 'es' }]}
            role="group"
            aria-label={copy.languageSelector}
          >
            <a
              id="lang-en-link"
              href="/v2/"
              hreflang="en"
              class={locale === 'en' ? 'active' : undefined}
              aria-current={locale === 'en' ? 'page' : undefined}>EN</a
            >
            <a
              id="lang-es-link"
              href="/es/v2/"
              hreflang="es"
              class={locale === 'es' ? 'active' : undefined}
              aria-current={locale === 'es' ? 'page' : undefined}>ES</a
            >
          </div>
          <a class="v2-btn v2-btn-primary v2-btn-sm" href="#contact">{copy.nav.contact}</a>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="v2-hero" aria-labelledby="v2-hero-title">
        <div class="v2-hero-copy">
          <h1 id="v2-hero-title" class="v2-hero-name">
            <span id="hero-name">{firstName}</span>
            <span id="hero-surname">{surname}</span>
          </h1>
          <p class="v2-hero-role">{copy.role}</p>
          <p class="v2-hero-summary">{copy.summary}</p>
          <div class="v2-actions">
            <a id="hero-email-link" class="v2-btn v2-btn-primary" href={`mailto:${email}`}>{copy.contact}</a>
            <details class="v2-cv">
              <summary class="v2-btn v2-btn-secondary">{copy.downloadCv}</summary>
              <ul class="v2-cv-menu">
                {
                  copy.cvOptions.map((option) => (
                    <li>
                      <a href={option.href} target="_blank" rel="noopener noreferrer">
                        <span>{option.label}</span>
                        <small>{option.note}</small>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
            <a
              id="hero-github-link"
              class="v2-link"
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer">GitHub</a
            >
            <a
              id="hero-linkedin-link"
              class="v2-link"
              href={linkedinUrl}
              target="_blank"
              rel="noopener noreferrer">LinkedIn</a
            >
          </div>
        </div>

        <aside class="v2-profile" aria-label={locale === 'es' ? 'Resumen del perfil' : 'Profile summary'}>
          <img
            src={resume.basics.image}
            width="112"
            height="112"
            alt={resume.basics.name}
            class="v2-photo"
            onerror="this.onerror=null;this.src='/favicon/favicon.ico';"
          />
          <dl class="v2-facts">
            <div class="metric-card">
              <dt>{copy.metrics.experience}</dt>
              <dd class="counter" data-target="10">10+</dd>
            </div>
            <div class="metric-card">
              <dt>{copy.metrics.skills}</dt>
              <dd class="counter" data-target="0">0</dd>
            </div>
            <div class="v2-facts-wide">
              <dt>{copy.metrics.focus}</dt>
              <dd>{copy.focusValue}</dd>
            </div>
          </dl>
        </aside>
      </section>

      <section id="experience" class="v2-section" aria-labelledby="v2-experience-title">
        <h2 id="v2-experience-title">{copy.experienceTitle}</h2>
        <div class="v2-panel">
          <div id="timeline-tip" class="v2-tip"></div>
          <div id="timeline"></div>
        </div>
      </section>

      <section id="method" class="v2-section" aria-labelledby="v2-method-title">
        <h2 id="v2-method-title">{copy.methodTitle}</h2>
        <p class="v2-lede">{copy.methodIntro}</p>
        <div class="v2-panel">
          <div id="flow-tip" class="v2-tip"></div>
          <div id="flow"></div>
        </div>
      </section>

      <section id="portfolio" class="v2-section" aria-labelledby="v2-projects-title">
        <div class="mb-8">
          <h2 id="v2-projects-title">{copy.projectsTitle}</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-5">
          {
            projects.map((project) => (
              <article class="v2-card">
                <h3>
                  {repoUrl(project) ? (
                    <a href={repoUrl(project)} target="_blank" rel="noopener noreferrer">
                      {project.name} <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    project.name
                  )}
                </h3>
                <p>{project.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <aside class="v2-cta-band" aria-label={copy.ctaBandTitle}>
        <div>
          <p class="v2-cta-title">{copy.ctaBandTitle}</p>
          <p class="v2-cta-text">{copy.ctaBandText}</p>
        </div>
        <div class="v2-actions">
          <a class="v2-btn v2-btn-secondary" href="/cv-one-page.pdf" target="_blank" rel="noopener noreferrer"
            >{copy.downloadCv}</a
          >
          <a class="v2-btn v2-btn-primary" href={`mailto:${email}`}>{copy.contact}</a>
        </div>
      </aside>

      <section class="v2-section" aria-labelledby="v2-capabilities-title">
        <h2 id="v2-capabilities-title">{copy.capabilitiesTitle}</h2>
        <ul class="v2-capabilities">
          {
            copy.capabilities.map((item) => (
              <li>
                <p class="v2-cap-label">{item.label}</p>
                <h3>{item.heading}</h3>
                <p>{item.description}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="skills" class="v2-section v2-skills" aria-labelledby="v2-skills-title">
        <div>
          <h2 id="v2-skills-title">{copy.skillsTitle}</h2>
          <div id="legend" class="flex flex-wrap gap-2 mt-6"></div>
          <div id="skill-keywords" class="v2-tip v2-keywords">{copy.skillsTip}</div>
        </div>
        <div class="v2-panel">
          <div id="bubbles"></div>
        </div>
      </section>

      <section id="contact" class="v2-contact" aria-labelledby="v2-contact-title">
        <h2 id="v2-contact-title">{copy.contactTitle}</h2>
        <p>{copy.contactText}</p>
        <a class="v2-btn v2-btn-primary" href={`mailto:${email}`}>{email}</a>
        <p class="v2-contact-links">
          <a class="v2-link" href={linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a class="v2-link" href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
        </p>
      </section>
    </main>

    <footer class="v2-footer">
      <p>
        © <span id="year">{new Date().getFullYear()}</span> David Barreiro Salgueiro · {copy.footerRole}
      </p>
    </footer>
  </div>
</BaseLayout>
