---
/**
 * Minimal document shell for the /v3/ redesign previews: SEO head (noindex),
 * no main-site scripts or global styles, and a small bar to return to the comparison page.
 */
import SeoHead from '../common/SeoHead.astro';
import { getAlternateLinks, getLocaleMetadata } from '../../lib/locale';

interface Props {
  option: string;
  label: string;
}

const { option, label } = Astro.props;
const seo = getLocaleMetadata('es');
---

<html lang="es">
  <head>
    <SeoHead
      title={`${label} · ${seo.title}`}
      description={seo.description}
      canonical={seo.canonical}
      ogLocale={seo.ogLocale}
      ogLocaleAlternate={seo.ogLocaleAlternate}
      ogTitle={seo.ogTitle}
      ogDescription={seo.ogDescription}
      alternates={getAlternateLinks()}
      noindex
    />
    <style is:global>
      .preview-bar {
        position: fixed;
        z-index: 1000;
        right: 12px;
        bottom: 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border-radius: 999px;
        background: #111;
        color: #fff;
        font:
          600 13px/1.2 system-ui,
          sans-serif;
        box-shadow: 0 8px 24px rgb(0 0 0 / 0.3);
      }
      .preview-bar a {
        color: #fff;
        text-decoration: underline;
        text-underline-offset: 2px;
      }
    </style>
  </head>
  <body>
    <slot />
    <div class="preview-bar" role="note">
      <span>Opción {option} · {label} · vista previa</span>
      <a href="/v3/">Comparar opciones</a>
    </div>
  </body>
</html>
