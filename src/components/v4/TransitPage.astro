---
/**
 * Redesign "Transit network" (routes /v4/ and /es/v4/).
 * The profile reads as a transit system: the data-platform method is a live line map,
 * the career is a line with expandable stops, projects are lines with a filter,
 * skills are zones. Standalone page: it does not load the main site's JS or Tailwind.
 */
import SeoHead from '../common/SeoHead.astro';
import { getAlternateLinks, getLocaleMetadata, type Locale } from '../../lib/locale';
import { getPreviewContent } from '../v3/previewContent';
import '../../styles/v4.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const seo = getLocaleMetadata(locale);
const c = getPreviewContent(locale);

const t = {
  en: {
    home: '/v4/',
    nav: {
      network: 'Network',
      career: 'Experience',
      projects: 'Projects',
      skills: 'Skills',
      contact: 'Contact'
    },
    langLabel: 'Language',
    eyebrowless: 'Senior Software Engineer',
    headline: 'I design real-time data platforms and the Go backends that move them.',
    lede: (years: number) =>
      `${years} years shipping production systems with Kafka, Spark, ClickHouse, Go and Java, from the first event to the dashboard that uses it.`,
    contact: 'Get in touch',
    cv: 'Download CV',
    cvOptions: {
      onePage: ['One page', 'Compact summary'],
      professional: ['Professional', 'Full detail, minimal layout'],
      jsonresume: ['JSON Resume', 'Standard format']
    },
    facts: (certs: number) => `${certs} certifications`,
    mapTitle: 'How I design data platforms',
    mapHint: 'Select a station to see what it solves.',
    legendData: 'Data line: the seven stages of a platform',
    legendWork: 'Work line: every job, up to today',
    legendEdu: 'Education line: university and further study',
    pause: 'Pause trains',
    resume: 'Resume trains',
    stationOf: (n: number, total: number) => `Station ${n} of ${total}`,
    connections: 'Connections',
    workStop: 'Work line',
    eduStop: 'Education line',
    today: 'today',
    careerTitle: 'Work experience',
    careerIntro: 'Every stop on the work line. Open one to see what I built there.',
    education: 'Education',
    highlights: 'What I did',
    projectsTitle: 'Project lines',
    projectsIntro:
      'Personal and technical work. Filter by topic; a project shows if it has any of the selected topics.',
    filterAll: 'All',
    filterLabel: 'Topics',
    showing: (n: number, total: number) => `${n} of ${total} projects`,
    clear: 'Clear',
    moreTopics: (n: number) => `${n} more topics`,
    lessTopics: 'Fewer topics',
    empty: 'No project matches these topics.',
    repo: 'Repository',
    skillsTitle: 'Skill zones',
    skillsIntro: 'The stack, grouped by zone. Pick a zone to see its technologies and level.',
    levels: { Advanced: 2, Intermediate: 1, Expert: 3 } as Record<string, number>,
    certified: 'Certified',
    certsTitle: 'Certifications',
    terminus: 'End of the line',
    contactTitle: "Let's build something with data",
    contactText:
      'Open to data engineering, streaming platforms and software architecture roles and projects.',
    footerRole: 'Senior Software Engineer',
    skip: 'Skip to content'
  },
  es: {
    home: '/es/v4/',
    nav: {
      network: 'Red',
      career: 'Experiencia',
      projects: 'Proyectos',
      skills: 'Skills',
      contact: 'Contacto'
    },
    langLabel: 'Idioma',
    eyebrowless: 'Ingeniero de Software Senior',
    headline: 'Diseño plataformas de datos en tiempo real y los backends en Go que las mueven.',
    lede: (years: number) =>
      `${years} años llevando sistemas a producción con Kafka, Spark, ClickHouse, Go y Java, desde el primer evento hasta el panel que lo usa.`,
    contact: 'Contactar',
    cv: 'Descargar CV',
    cvOptions: {
      onePage: ['Una página', 'Resumen compacto · en inglés'],
      professional: ['Profesional', 'Completo, diseño sobrio · en inglés'],
      jsonresume: ['JSON Resume', 'Formato estándar · en inglés']
    },
    facts: (certs: number) => `${certs} certificaciones`,
    mapTitle: 'Cómo diseño plataformas de datos',
    mapHint: 'Elige una estación para ver qué resuelve.',
    legendData: 'Línea de datos: las siete etapas de una plataforma',
    legendWork: 'Línea laboral: cada empresa, hasta hoy',
    legendEdu: 'Línea de formación: universidad y estudios',
    pause: 'Pausar trenes',
    resume: 'Reanudar trenes',
    stationOf: (n: number, total: number) => `Estación ${n} de ${total}`,
    connections: 'Correspondencias',
    workStop: 'Línea laboral',
    eduStop: 'Línea de formación',
    today: 'hoy',
    careerTitle: 'Experiencia laboral',
    careerIntro: 'Cada parada de la línea laboral. Abre una para ver qué construí allí.',
    education: 'Formación',
    highlights: 'Qué hice',
    projectsTitle: 'Líneas de proyecto',
    projectsIntro:
      'Trabajo personal y técnico. Filtra por tema; un proyecto aparece si tiene alguno de los temas elegidos.',
    filterAll: 'Todos',
    filterLabel: 'Temas',
    showing: (n: number, total: number) => `${n} de ${total} proyectos`,
    clear: 'Limpiar',
    moreTopics: (n: number) => `${n} temas más`,
    lessTopics: 'Menos temas',
    empty: 'Ningún proyecto coincide con estos temas.',
    repo: 'Repositorio',
    skillsTitle: 'Zonas de skills',
    skillsIntro: 'El stack, agrupado por zonas. Elige una zona para ver sus tecnologías y nivel.',
    levels: { Avanzado: 2, Intermedio: 1, Experto: 3 } as Record<string, number>,
    certified: 'Certificado',
    certsTitle: 'Certificaciones',
    terminus: 'Final de trayecto',
    contactTitle: 'Construyamos algo con datos',
    contactText:
      'Abierto a puestos y proyectos de ingeniería de datos, plataformas streaming y arquitectura de software.',
    footerRole: 'Ingeniero de Software Senior',
    skip: 'Saltar al contenido'
  }
}[locale];

const nowYear = new Date().getFullYear();
const firstWorkYear = Math.min(...c.work.map((job) => job.start));
const years = nowYear - firstWorkYear;

// ---------- Map geometry (viewBox 0 -50 1000 720; top margin holds the rotated labels) ----------
// Three lines: the data-platform method (red), work (blue) and education (green).
// Work meets the data line at the current job; education crosses work at the first job.
const DATA_PATH = 'M 40 120 H 330 L 470 260 H 790 L 910 380 H 965';
const WORK_PATH = 'M 260 560 H 420 L 520 460 V 260';
const EDU_PATH = 'M 60 440 H 200 L 260 500 V 640';
const dataStops = [
  [70, 120],
  [190, 120],
  [310, 120],
  [520, 260],
  [640, 260],
  [760, 260],
  [945, 380]
].map(([x, y], index) => ({ x, y, ...c.stages[index], index }));

type LabelSide = 'below' | 'left' | 'right' | 'aboveLeft' | 'none';
const placeStops = <T,>(
  entries: T[],
  first: [number, number, LabelSide],
  middle: [number, number, LabelSide][],
  last: [number, number, LabelSide]
) =>
  entries.map((entry, index) => {
    const [x, y, label] =
      index === 0
        ? first
        : index === entries.length - 1
          ? last
          : middle[Math.min(index - 1, middle.length - 1)];
    return { ...entry, x, y, label, index };
  });

const byStart = <T extends { start: number }>(list: T[]) => [...list].sort((a, b) => a.start - b.start);
// First job sits on the education interchange; the current job sits on the data-line interchange (drawn there).
const workStops = placeStops(
  byStart(c.work),
  [260, 560, 'aboveLeft'],
  [
    [370, 560, 'below'],
    [520, 380, 'left'],
    [470, 510, 'left']
  ],
  [520, 260, 'none']
);
const eduStops = placeStops(
  byStart(c.education),
  [100, 440, 'below'],
  [[160, 440, 'below']],
  [260, 630, 'right']
);
const shortOrg = (name: string) => name.match(/\(([^)]+)\)\s*$/)?.[1] ?? name.replace(/\s+S\.L\.$/, '');
const toBoard = (stop: (typeof workStops)[number]) => ({
  name: stop.organisation,
  detail: `${stop.period} · ${stop.role}${stop.summary ? ` — ${stop.summary}` : ''}`,
  tech: stop.tech
});

const stopsData = {
  data: dataStops.map((stop) => ({ name: stop.name, detail: stop.detail, tech: stop.tech })),
  work: workStops.map(toBoard),
  edu: eduStops.map(toBoard)
};

// ---------- Projects ----------
const LINE_COLOURS = ['#00985f', '#f2a900', '#7a3fa0', '#e4002b', '#0a5ec2', '#00a3ad', '#f26b21'];
const tagCounts = new Map<string, number>();
c.projects.forEach((project) =>
  project.allTags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1))
);
// Most frequent topics first; the long tail stays behind a toggle so the filter stays scannable.
const PRIMARY_TAGS = 10;
const allTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag]) => tag);

// Most recent first.
const certificates = [...c.certificateDetails].sort((a, b) => b.date.localeCompare(a.date));

const levelDots = (level: string) => t.levels[level] ?? 0;
---

<html lang={locale}>
  <head>
    <SeoHead
      title={seo.title}
      description={seo.description}
      canonical={seo.canonical}
      ogLocale={seo.ogLocale}
      ogLocaleAlternate={seo.ogLocaleAlternate}
      ogTitle={seo.ogTitle}
      ogDescription={seo.ogDescription}
      alternates={getAlternateLinks()}
      noindex
    />
    <link
      rel="preload"
      href="/assets/fonts/schibsted-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#f5f3ee" />
  </head>
  <body class="tn">
    <a class="tn-skip" href="#main">{t.skip}</a>

    <header class="tn-bar">
      <a class="tn-brand" href={t.home} aria-label="David Barreiro">
        <svg viewBox="0 0 36 36" width="34" height="34" aria-hidden="true">
          <circle cx="18" cy="18" r="14" fill="#fff" stroke="#121212" stroke-width="5"></circle>
          <path d="M2 18 H34" stroke="#e4002b" stroke-width="5"></path>
          <circle cx="18" cy="18" r="6" fill="#fff" stroke="#121212" stroke-width="3"></circle>
        </svg>
        <span>David Barreiro</span>
      </a>
      <nav class="tn-nav" aria-label={locale === 'es' ? 'Secciones' : 'Sections'}>
        <a href="#red">{t.nav.network}</a>
        <a href="#carrera">{t.nav.career}</a>
        <a href="#proyectos">{t.nav.projects}</a>
        <a href="#skills">{t.nav.skills}</a>
      </nav>
      <div class="tn-bar-end">
        <div class="tn-lang" role="group" aria-label={t.langLabel}>
          <a href="/v4/" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
          <a href="/es/v4/" hreflang="es" aria-current={locale === 'es' ? 'page' : undefined}>ES</a>
        </div>
        <a class="tn-btn tn-btn-sm" href="#contacto">{t.nav.contact}</a>
      </div>
    </header>

    <main id="main">
      <!-- ============ HERO: the live network ============ -->
      <section class="tn-hero" id="red" aria-labelledby="tn-title">
        <div class="tn-hero-copy">
          <p class="tn-role">{t.eyebrowless}</p>
          <h1 id="tn-title" class="tn-name">David<br />Barreiro</h1>
          <p class="tn-headline">{t.headline}</p>
          <p class="tn-lede">{t.lede(years)}</p>
          <div class="tn-actions">
            <a class="tn-btn" href={`mailto:${c.email}`}>{t.contact}</a>
            <details class="tn-cv" data-cv>
              <summary class="tn-btn tn-btn-line">{t.cv}</summary>
              <ul>
                {
                  c.cvOptions.map((option) => (
                    <li>
                      <a href={option.href} target="_blank" rel="noopener noreferrer">
                        <strong>{t.cvOptions[option.key][0]}</strong>
                        <span>{t.cvOptions[option.key][1]}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
          </div>
          <p class="tn-links">
            <a href={c.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href={c.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <span>{t.facts(certificates.length)}</span>
          </p>
        </div>

        <div class="tn-map-block">
          <div class="tn-map-head">
            <h2>{t.mapTitle}</h2>
            <button
              type="button"
              class="tn-pause"
              data-pause
              aria-pressed="false"
              data-label-pause={t.pause}
              data-label-resume={t.resume}
            >
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" class="tn-pause-icon">
                <rect x="3" y="2" width="3.5" height="12" rx="1"></rect>
                <rect x="9.5" y="2" width="3.5" height="12" rx="1"></rect>
              </svg>
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" class="tn-play-icon">
                <path d="M4 2.5 L13.5 8 L4 13.5 Z"></path>
              </svg>
              <span data-pause-text>{t.pause}</span>
            </button>
          </div>

          <!-- Desktop / tablet: the drawn map -->
          <svg class="tn-map" viewBox="0 -50 1000 720" role="group" aria-label={t.mapTitle} data-map>
            <defs>
              <path id="tn-data-path" d={DATA_PATH}></path>
              <path id="tn-work-path" d={WORK_PATH}></path>
              <path id="tn-edu-path" d={EDU_PATH}></path>
            </defs>
            <path class="tn-line tn-line-edu" d={EDU_PATH}></path>
            <path class="tn-line tn-line-career" d={WORK_PATH}></path>
            <path class="tn-line tn-line-data" d={DATA_PATH}></path>

            <!-- trains -->
            {
              [0, 1, 2].map((n) => (
                <g class="tn-train tn-train-data">
                  <rect x="-13" y="-5" width="26" height="10" rx="5" />
                  <animateMotion dur="14s" begin={`${n * -4.6}s`} repeatCount="indefinite" rotate="auto">
                    <mpath href="#tn-data-path" />
                  </animateMotion>
                </g>
              ))
            }
            {
              [0, 1].map((n) => (
                <g class="tn-train tn-train-career">
                  <rect x="-11" y="-4.5" width="22" height="9" rx="4.5" />
                  <animateMotion dur="8s" begin={`${n * -4}s`} repeatCount="indefinite" rotate="auto">
                    <mpath href="#tn-work-path" />
                  </animateMotion>
                </g>
              ))
            }
            <g class="tn-train tn-train-edu">
              <rect x="-11" y="-4.5" width="22" height="9" rx="4.5"></rect>
              <animateMotion dur="7s" repeatCount="indefinite" rotate="auto">
                <mpath href="#tn-edu-path"></mpath>
              </animateMotion>
            </g>

            <!-- work and education stops (the current job is drawn as the data-line interchange) -->
            {
              [
                ...eduStops.map((stop) => ({ ...stop, line: 'edu' })),
                ...workStops.map((stop) => ({ ...stop, line: 'work' }))
              ]
                .filter((stop) => stop.label !== 'none')
                .map((stop) => {
                  const crossing = stop.line === 'work' && stop.index === 0;
                  return (
                    <g
                      class:list={[
                        'tn-stop',
                        stop.line === 'work' ? 'tn-stop-career' : 'tn-stop-edu',
                        { 'is-interchange': crossing }
                      ]}
                      data-stop={`${stop.line}-${stop.index}`}
                      tabindex="0"
                      role="button"
                      aria-label={`${stop.organisation}, ${stop.period}`}
                      transform={`translate(${stop.x} ${stop.y})`}
                    >
                      <circle class="tn-hit" r="22" />
                      {crossing ? (
                        <>
                          <rect class="tn-ring" x="-22" y="-22" width="44" height="44" rx="22" />
                          <rect class="tn-dot" x="-13" y="-13" width="26" height="26" rx="13" />
                        </>
                      ) : (
                        <>
                          <circle class="tn-ring" r="17" />
                          <circle class="tn-dot" r="9" />
                        </>
                      )}
                      {stop.label === 'below' && (
                        <text class="tn-label tn-label-sm" y="34" text-anchor="middle">
                          <tspan x="0" class="tn-year">
                            {stop.start}
                          </tspan>
                          <tspan x="0" dy="17">
                            {shortOrg(stop.organisation)}
                          </tspan>
                        </text>
                      )}
                      {stop.label === 'left' && (
                        <text class="tn-label tn-label-sm" x="-20" y="5" text-anchor="end">
                          <tspan class="tn-year">{stop.start}</tspan> {shortOrg(stop.organisation)}
                        </text>
                      )}
                      {stop.label === 'right' && (
                        <text class="tn-label tn-label-sm" x="22" y="5">
                          <tspan class="tn-year">{stop.start}</tspan> {shortOrg(stop.organisation)}
                        </text>
                      )}
                      {stop.label === 'aboveLeft' && (
                        <text class="tn-label tn-label-sm" x="-24" y="-22" text-anchor="end">
                          <tspan class="tn-year">{stop.start}</tspan> {shortOrg(stop.organisation)}
                        </text>
                      )}
                    </g>
                  );
                })
            }

            <!-- data stops (index 3 is the interchange with the career line) -->
            {
              dataStops.map((stop) => (
                <g
                  class:list={['tn-stop', 'tn-stop-data', { 'is-interchange': stop.index === 3 }]}
                  data-stop={`data-${stop.index}`}
                  tabindex="0"
                  role="button"
                  aria-label={`${stop.index + 1}. ${stop.name}`}
                  transform={`translate(${stop.x} ${stop.y})`}
                >
                  <circle class="tn-hit" r="24" />
                  {stop.index === 3 ? (
                    <>
                      <rect class="tn-ring" x="-24" y="-24" width="48" height="48" rx="24" />
                      <rect class="tn-dot tn-dot-xl" x="-15" y="-15" width="30" height="30" rx="15" />
                    </>
                  ) : (
                    <>
                      <circle class="tn-ring" r="18" />
                      <circle class="tn-dot" r="10" />
                    </>
                  )}
                  {stop.index === dataStops.length - 1 ? (
                    <text class="tn-label" x="14" y="52" text-anchor="end">
                      {stop.name}
                    </text>
                  ) : (
                    <text class="tn-label" transform="translate(10 -30) rotate(-32)">
                      {stop.name}
                    </text>
                  )}
                </g>
              ))
            }
            <text class="tn-label tn-label-sm tn-interchange-note" x="548" y="300">
              {workStops.at(-1)?.organisation} · {t.today}
            </text>
          </svg>

          <!-- Phone: the same data line, vertical -->
          <ol class="tn-line-list" aria-label={t.mapTitle}>
            {
              dataStops.map((stop) => (
                <li>
                  <button type="button" data-stop={`data-${stop.index}`}>
                    <span class="tn-line-list-num">{stop.index + 1}</span>
                    <span>{stop.name}</span>
                  </button>
                </li>
              ))
            }
          </ol>

          <div class="tn-board" aria-live="off" data-board>
            <p class="tn-board-meta" data-board-meta>{t.stationOf(1, dataStops.length)}</p>
            <p class="tn-board-name" data-board-name>{dataStops[0].name}</p>
            <p class="tn-board-detail" data-board-detail>{dataStops[0].detail}</p>
            <p class="tn-board-tech">
              <span class="tn-board-tech-label">{t.connections}</span>
              <span data-board-tech>{dataStops[0].tech.join(' · ')}</span>
            </p>
          </div>

          <ul class="tn-legend">
            <li><span class="tn-swatch tn-swatch-data"></span>{t.legendData}</li>
            <li><span class="tn-swatch tn-swatch-career"></span>{t.legendWork}</li>
            <li><span class="tn-swatch tn-swatch-edu"></span>{t.legendEdu}</li>
          </ul>
        </div>
      </section>

      <!-- ============ WORK EXPERIENCE ============ -->
      <section class="tn-section tn-career" id="carrera" aria-labelledby="career-title">
        <div class="tn-section-head">
          <h2 id="career-title">{t.careerTitle}</h2>
          <p>{t.careerIntro}</p>
        </div>
        <ol class="tn-stops">
          {
            c.work.map((entry, index) => (
              <li>
                <details open={index === 0}>
                  <summary>
                    <span class="tn-stops-period">{entry.period}</span>
                    <span class="tn-stops-org">{entry.organisation}</span>
                    <span class="tn-stops-role">{entry.role}</span>
                  </summary>
                  <div class="tn-stops-body">
                    {entry.summary && <p>{entry.summary}</p>}
                    {entry.highlights.length > 0 && (
                      <>
                        <h3>{t.highlights}</h3>
                        <ul>
                          {entry.highlights.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </>
                    )}
                    {entry.tech.length > 0 && (
                      <p class="tn-chips">
                        {entry.tech.map((tech) => (
                          <span>{tech}</span>
                        ))}
                      </p>
                    )}
                  </div>
                </details>
              </li>
            ))
          }
        </ol>

        <h3 class="tn-edu-title">
          <span class="tn-swatch tn-swatch-edu" aria-hidden="true"></span>{t.education}
        </h3>
        <ol class="tn-edu">
          {
            byStart(c.education)
              .reverse()
              .map((entry) => (
                <li>
                  <span class="tn-stops-period">{entry.period}</span>
                  <div>
                    <p class="tn-edu-org">{entry.organisation}</p>
                    <p class="tn-edu-role">{entry.role}</p>
                    {entry.tech.length > 0 && <p class="tn-edu-tech">{entry.tech.join(' · ')}</p>}
                  </div>
                </li>
              ))
          }
        </ol>
      </section>

      <!-- ============ PROJECTS ============ -->
      <section class="tn-section" id="proyectos" aria-labelledby="projects-title" data-projects>
        <div class="tn-section-head">
          <h2 id="projects-title">{t.projectsTitle}</h2>
          <p>{t.projectsIntro}</p>
        </div>

        <div class="tn-filter" role="group" aria-label={t.filterLabel}>
          <button type="button" class="tn-chip" data-tag="" aria-pressed="true">{t.filterAll}</button>
          {
            allTags.map((tag, index) => (
              <button
                type="button"
                class:list={['tn-chip', { 'is-extra': index >= PRIMARY_TAGS }]}
                data-tag={tag}
                aria-pressed="false"
              >
                {tag}
              </button>
            ))
          }
          {
            allTags.length > PRIMARY_TAGS && (
              <button
                type="button"
                class="tn-more"
                data-more
                aria-expanded="false"
                data-label-more={t.moreTopics(allTags.length - PRIMARY_TAGS)}
                data-label-less={t.lessTopics}
              >
                {t.moreTopics(allTags.length - PRIMARY_TAGS)}
              </button>
            )
          }
        </div>
        <p class="tn-filter-status">
          <span data-count>{t.showing(c.projects.length, c.projects.length)}</span>
          <button type="button" class="tn-clear" data-clear hidden>{t.clear}</button>
        </p>

        <ol class="tn-projects">
          {
            c.projects.map((project, index) => (
              <li data-tags={JSON.stringify(project.allTags)}>
                <span
                  class="tn-roundel"
                  style={`--line:${LINE_COLOURS[index % LINE_COLOURS.length]}`}
                  aria-hidden="true"
                >
                  {String.fromCharCode(65 + index)}
                </span>
                <div>
                  <h3>
                    {project.url ? (
                      <a href={project.url} target="_blank" rel="noopener noreferrer">
                        {project.name}
                        <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" class="tn-ext">
                          <path
                            d="M3 9 L9 3 M4 3 H9 V8"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.6"
                          />
                        </svg>
                        <span class="tn-sr">({t.repo})</span>
                      </a>
                    ) : (
                      project.name
                    )}
                  </h3>
                  <p>{project.oneLiner}</p>
                  <p class="tn-tags">{project.allTags.join(' · ')}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="tn-empty" data-empty hidden>{t.empty}</p>
      </section>

      <!-- ============ SKILLS ============ -->
      <section class="tn-section" id="skills" aria-labelledby="skills-title" data-skills>
        <div class="tn-section-head">
          <h2 id="skills-title">{t.skillsTitle}</h2>
          <p>{t.skillsIntro}</p>
        </div>
        <div class="tn-zones" role="tablist" aria-label={t.skillsTitle}>
          {
            c.skillGroups.map((group, index) => (
              <button
                type="button"
                role="tab"
                id={`zone-tab-${index}`}
                aria-controls={`zone-panel-${index}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
              >
                <span class="tn-zone-num">{index + 1}</span>
                {group.name}
              </button>
            ))
          }
        </div>
        {
          c.skillGroups.map((group, index) => (
            <div
              class="tn-zone-panel"
              role="tabpanel"
              id={`zone-panel-${index}`}
              aria-labelledby={`zone-tab-${index}`}
              hidden={index !== 0}
            >
              <ul class="tn-skill-grid">
                {group.keywords.map((skill) => (
                  <li>
                    {skill.logo ? (
                      <img src={skill.logo} alt="" width="36" height="36" loading="lazy" />
                    ) : (
                      <span class="tn-skill-ph" aria-hidden="true" />
                    )}
                    <div>
                      <p class="tn-skill-name">{skill.name}</p>
                      <p class="tn-skill-level">
                        <span class="tn-meter" aria-hidden="true">
                          {[1, 2, 3].map((n) => (
                            <i class:list={{ on: n <= levelDots(skill.level) }} />
                          ))}
                        </span>
                        {skill.level}
                      </p>
                      {skill.certifications.map((cert) => (
                        <a class="tn-cert" href={cert.url} target="_blank" rel="noopener noreferrer">
                          {t.certified} · {cert.issuer}
                        </a>
                      ))}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <h3 class="tn-certs-title">{t.certsTitle}</h3>
        <ul class="tn-certs">
          {
            certificates.map((cert) => (
              <li>
                {cert.url ? (
                  <a href={cert.url} target="_blank" rel="noopener noreferrer">
                    {cert.name}
                  </a>
                ) : (
                  cert.name
                )}
                {cert.date && <span>{cert.date.slice(0, 4)}</span>}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- ============ CONTACT: the terminus ============ -->
      <section class="tn-terminus" id="contacto" aria-labelledby="contact-title">
        <div class="tn-terminus-line" aria-hidden="true">
          <span></span>
          <svg viewBox="0 0 60 60" width="60" height="60">
            <rect x="5" y="5" width="50" height="50" rx="25" fill="#fff" stroke="#e4002b" stroke-width="7"
            ></rect>
          </svg>
        </div>
        <p class="tn-terminus-name">{t.terminus}</p>
        <h2 id="contact-title">{t.contactTitle}</h2>
        <p>{t.contactText}</p>
        <div class="tn-actions">
          <a class="tn-btn tn-btn-invert" href={`mailto:${c.email}`}>{c.email}</a>
          <a class="tn-btn tn-btn-ghost" href={c.cvUrl} target="_blank" rel="noopener noreferrer">{t.cv}</a>
        </div>
        <p class="tn-links tn-links-invert">
          <a href={c.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href={c.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
        </p>
      </section>
    </main>

    <footer class="tn-footer">
      <p>© {nowYear} {c.name} · {t.footerRole}</p>
    </footer>

    <script
      is:inline
      type="application/json"
      id="tn-stops"
      set:html={JSON.stringify({
        ...stopsData,
        labels: {
          station: t.stationOf(0, 0).replace(/\d+/g, '{n}'),
          workStop: t.workStop,
          eduStop: t.eduStop,
          total: dataStops.length,
          showing: t.showing(0, 0).replace(/\d+/g, '{n}')
        }
      })}
    />
    <script>
      import './transit.ts';
    </script>
  </body>
</html>
