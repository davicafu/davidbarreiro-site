---
/**
 * Redesign "Instrument panel" (routes /v8/ and /es/v8/).
 * The portfolio as a piece of precision hardware: a machined front panel with an LCD
 * driven by a rotary selector, the design method as a chain of patched modules, the
 * career as a two-track step sequencer, projects as cartridges filtered by channel keys
 * and skills as banks of level knobs. Standalone page: it does not load the main site's
 * JS or Tailwind.
 */
import SeoHead from '../common/SeoHead.astro';
import { getAlternateLinks, getLocaleMetadata, type Locale } from '../../lib/locale';
import { getPreviewContent } from '../v3/previewContent';
import '../../styles/v8.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const seo = getLocaleMetadata(locale);
const c = getPreviewContent(locale);

const t = {
  en: {
    home: '/v8/',
    sections: 'Sections',
    menu: 'Menu',
    nav: { method: 'Method', work: 'Experience', projects: 'Projects', skills: 'Skills', contact: 'Contact' },
    langLabel: 'Language',
    skip: 'Skip to content',
    model: 'Model DB-14 · Data platform instrument',
    role: 'Senior Software Engineer',
    headline: 'I build real-time data platforms and the Go backends that keep them running.',
    lede: (years: number) =>
      `${years} years taking systems to production with Kafka, Spark, ClickHouse, Go and Java, from the first event to the dashboard that uses it.`,
    contact: 'Get in touch',
    cv: 'Download CV',
    cvOptions: {
      onePage: ['One page', 'Compact summary'],
      professional: ['Professional', 'Full detail, minimal layout'],
      jsonresume: ['JSON Resume', 'Standard format']
