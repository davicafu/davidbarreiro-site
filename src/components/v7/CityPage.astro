    { type: 'disc', g: [14.6, 1.8, 0.8, 0.55, 0.68] },
    { type: 'disc', g: [14.6, 1.8, 0.8, 0.55, 1.36] },
    { type: 'disc', g: [16.5, 1.6, 0.75, 0.55, 0] },
    { type: 'disc', g: [16.5, 1.6, 0.75, 0.55, 0.68] },
    { type: 'disc', g: [15.6, 3.4, 0.7, 0.55, 0] }
  ],
  // 6 · observability: a monitoring tower with a live screen
  [
    { type: 'box', g: [19.3, 1.4, 1.3, 1.3, 0.4], leds: true },
    { type: 'box', g: [19.8, 1.95, 0.3, 0.3, 2.6, 0.4] },
    { type: 'box', g: [19.0, 1.75, 1.9, 0.2, 1.15, 3.0] }
  ],
  // 7 · consumers: Go service pods behind an API gateway
  [
    { type: 'box', g: [18.3, -2.1, 3.6, 1.1, 0.35], leds: true },
    { type: 'box', g: [18.5, -4.0, 1.1, 1.1, 0.95], units: 2, leds: true },
    { type: 'box', g: [19.95, -3.95, 0.9, 0.9, 1.3], units: 2, leds: true },
    { type: 'box', g: [21.1, -4.0, 0.8, 1.1, 0.7], leds: true }
  ]
];
// Namespaces for the service labels; the service name comes from each layer's first technology.
const NAMESPACES = ['src', 'ingest', 'stream', 'proc', 'store', 'obs', 'serve'];

let ledSeed = 0;
const stages = c.stages.slice(0, STAGE_PARTS.length).map((stage, index) => {
  const parts = STAGE_PARTS[index];
  const tops: number[] = [];
  const xs: number[] = [];
  const ys: number[] = [];
  const shapes = parts
    .map((part) => {
      if (part.type === 'disc') {
        const [cx, cy, r, h, gz] = part.g;
        tops.push(gz + h);
        xs.push(cx - r, cx + r);
        ys.push(cy - r, cy + r);
        ledSeed += 1;
        return { kind: 'disc' as const, z: gz, depth: cx + cy + 2 * r, ...disc(cx, cy, r, h, gz), delay: (ledSeed * 0.37) % 2.4 };
      }
      const [gx, gy, w, d, h, gz = 0] = part.g;
      tops.push(gz + h);
      xs.push(gx, gx + w);
      ys.push(gy, gy + d);
      const units = part.units ?? 1;
      const lines: string[] = [];
      for (let k = 1; k < units; k += 1) {
        const z = gz + (h * k) / units;
        lines.push(fmt([iso(gx, gy + d, z), iso(gx + w, gy + d, z)]));
        lines.push(fmt([iso(gx + w, gy, z), iso(gx + w, gy + d, z)]));
      }
      const leds: { x: number; y: number; delay: number }[] = [];
      if (part.leds) {
        for (let k = 0; k < units; k += 1) {
          const [x, y] = iso(gx + Math.min(0.28, w * 0.22), gy + d, gz + (h * (k + 0.5)) / units);
          ledSeed += 1;
          leds.push({ x, y, delay: (ledSeed * 0.37) % 2.4 });
        }
      }
      return { kind: 'box' as const, z: gz, depth: gx + w + gy + d, ...box(gx, gy, gz, w, d, h), lines, leds };
    })
    // Painter's order: lower levels first, then far before near.
    .sort((a, b) => a.z - b.z || a.depth - b.depth);
  const ax = (Math.min(...xs) + Math.max(...xs)) / 2;
  const ay = (Math.min(...ys) + Math.max(...ys)) / 2;
  const height = Math.max(...tops);
  const [pinX, pinY] = iso(ax, ay, height + 1.1);
  const [, baseY] = iso(ax, ay, height + 0.1);
  const namespace = NAMESPACES[index] ?? 'svc';
  const service = `${namespace}/${slug(stage.tech[0] ?? stage.name)}`;
  // Each layer reports its own kind of metrics (ingestion lag, storage compression, serving latency...).
  const telemetry = (t.probes[namespace] ?? t.probes.proc).map(([label, base, spread, dp, unit]) => ({
    label,
    base,
    spread,
    dp,
    unit
  }));
  return {
    ...stage,
    index,
    service,
    telemetry,
    shapes,
    pin: { x: pinX, y: pinY, baseY },
    // The monitoring screen draws a live chart and carries a beacon.
    screen:
      index === 5
        ? {
            spark: fmt(
              [0.1, 0.35, 0.25, 0.55, 0.42, 0.7, 0.5, 0.85, 0.62].map((v, k) =>
                iso(19.15 + (k * 1.6) / 8, 1.95, 3.15 + v * 0.85)
              )
            ),
            beacon: iso(19.95, 1.85, 4.3)
          }
        : null,
    depth: ax + ay
  };
});

// Platform: stepped zones that follow the flow. Sides first, then tops, so the tops merge.
const ZONES: [number, number, number, number, string][] = [
  [0, 8.1, 10.8, 5, 'ZONE A · EDGE'],
  [6.2, 3.5, 11.2, 5, 'ZONE B · STREAM'],
  [12.8, -0.6, 9.8, 4.6, 'ZONE C · DATA'],
  [17.4, -5, 5.2, 4.8, 'ZONE D · SERVE']
];
const ZONE_H = 0.45;
const platform = ZONES.map(([gx, gy, w, d]) => box(gx, gy, -ZONE_H, w, d, ZONE_H));
// Zone labels lie flat on the platform, written along the x axis.
const zoneLabels = ZONES.map(([gx, gy, , d, label]) => {
  const [x, y] = iso(gx + 0.35, gy + d - 0.35, 0);
  return { label, transform: `matrix(${COS.toFixed(4)} 0.5 ${(-COS).toFixed(4)} 0.5 ${f1(x)} ${f1(y)})` };
});

// Grid lines on the platform, clipped to its tops.
const gridLines: string[] = [];
for (let gx = 0; gx <= 23; gx += 1) gridLines.push(fmt([iso(gx, -5), iso(gx, 13.1)]));
for (let gy = -5; gy <= 13; gy += 1) gridLines.push(fmt([iso(0, gy), iso(22.6, gy)]));

// Data link: a Manhattan route through every layer, slightly above the platform.
const ROUTE: Pt[] = [
  [2.2, 10.6],
  [7.1, 10.6],
  [9.8, 10.6],
  [9.8, 5.55],
  [14, 5.55],
  [15.5, 5.55],
  [15.5, 2.5],
  [19.95, 2.5],
  [19.95, -1.55],
  [20.6, -1.55]
];
const link = `M ${ROUTE.map(([gx, gy]) => iso(gx, gy, 0.02).map(f1).join(' ')).join(' L ')}`;

// Idle nodes around the layers: the rest of the cluster.
const IDLE: [number, number, number, number, number][] = [
  [8.9, 7.3, 1.1, 0.9, 0.5],
  [6.7, 3.9, 1.2, 0.8, 0.42],
  [12.9, 0, 1.2, 0.9, 0.7],
  [17.6, 6.3, 1.1, 1.1, 0.5],
  [4.6, 12.3, 0.9, 0.7, 0.42],
  [21.6, 3.3, 0.8, 0.8, 0.5]
];
const idle = IDLE.map(([gx, gy, w, d, h], index) => {
  const [lx, ly] = iso(gx + 0.25, gy + d, h / 2);
  return { ...box(gx, gy, 0, w, d, h), led: [lx, ly] as Pt, depth: gx + w + gy + d, delay: (index * 0.53) % 2.4 };
});

type Drawable =
  | { kind: 'stage'; depth: number; stage: (typeof stages)[number] }
  | { kind: 'idle'; depth: number; node: (typeof idle)[number] };
const scene: Drawable[] = [
  ...stages.map((stage) => ({ kind: 'stage' as const, depth: stage.depth, stage })),
  ...idle.map((node) => ({ kind: 'idle' as const, depth: node.depth - 1, node }))
].sort((a, b) => a.depth - b.depth);

// The view box hugs the model.
const bounds = (() => {
  const xs: number[] = [];
  const ys: number[] = [];
  ZONES.forEach(([gx, gy, w, d]) =>
    [iso(gx, gy, 0), iso(gx + w, gy, 0), iso(gx, gy + d, 0), iso(gx + w, gy + d, -ZONE_H)].forEach(([x, y]) => {
      xs.push(x);
      ys.push(y);
    })
  );
  stages.forEach((stage) => ys.push(stage.pin.y - 16));
  return {
    x: Math.min(...xs) - 12,
    y: Math.min(...ys) - 8,
    w: Math.max(...xs) - Math.min(...xs) + 24,
    h: Math.max(...ys) - Math.min(...ys) + 26
  };
})();
const viewBox = `${bounds.x.toFixed(0)} ${bounds.y.toFixed(0)} ${bounds.w.toFixed(0)} ${bounds.h.toFixed(0)}`;
const packet = box(-0.2, -0.2, 0.05, 0.4, 0.4, 0.26);

// ---------- Releases (work) and base image (education) ----------
const releases = [...c.work].sort((a, b) => b.start - a.start);
const layers = [...c.education].sort((a, b) => b.start - a.start);
// A short, stable hash so every layer looks like an image digest.
const digest = (text: string) => {
  let h = 2166136261;
  for (const ch of text) h = Math.imul(h ^ ch.charCodeAt(0), 16777619);
  return (h >>> 0).toString(16).padStart(8, '0').slice(0, 7);
};

// ---------- Projects ----------
const tagCounts = new Map<string, number>();
c.projects.forEach((project) => project.allTags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1)));
const PRIMARY_TAGS = 10;
const allTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).map(([tag]) => tag);
// One line icon per repository topic (24×24, stroked), matched by project name; first match wins.
const PROJECT_ICONS: [RegExp, string][] = [
  // auth kit: a shield with a lock
  [
    /auth/i,
    '<path d="M12 3 L19 6 V11.5 C19 16 16 19.3 12 21 C8 19.3 5 16 5 11.5 V6 Z"/><rect x="9" y="11" width="6" height="5" rx="1"/><path d="M10.2 11 V9.6 a1.8 1.8 0 0 1 3.6 0 V11"/>'
  ],
  // worker runtime: a queue fanning out into parallel lanes
  [
    /worker/i,
    '<rect x="2.5" y="9" width="4" height="6" rx="1"/><path d="M6.5 12 L10 6 H21.5 M6.5 12 H21.5 M6.5 12 L10 18 H21.5"/><rect x="14" y="4.5" width="3" height="3" rx="0.6"/><rect x="16.5" y="10.5" width="3" height="3" rx="0.6"/><rect x="12" y="16.5" width="3" height="3" rx="0.6"/>'
  ],
  // microservice suite: connected service nodes
  [
    /microservice|service/i,
    '<circle cx="6" cy="6.5" r="2.5"/><circle cx="18" cy="6.5" r="2.5"/><circle cx="12" cy="17.5" r="2.5"/><path d="M8.5 6.5 H15.5 M7.3 8.7 L10.7 15.3 M16.7 8.7 L13.3 15.3"/>'
  ],
  // event analytics: an event stream feeding a chart
  [
    /event|evento|analytic|anal[ií]tic/i,
    '<circle cx="4.5" cy="5" r="1.2"/><circle cx="8.5" cy="5" r="1.2"/><circle cx="12.5" cy="5" r="1.2"/><path d="M15.5 5 H20.5 M18.5 3 L20.5 5 L18.5 7"/><path d="M3 21 H21 M4.5 18.5 L9 13.5 L12.5 16 L19.5 9.5"/>'
  ],
  // observability kit: a pulse inside a radar ring
  [
    /observ|trace|monitor/i,
    '<circle cx="12" cy="12" r="9"/><path d="M3 12 H7.5 L9.5 7.5 L13 16.5 L15 12 H21"/>'
  ],
  // games: a gamepad (before the CLI rule, as the collection is also a CLI)
  [
    /game|juego/i,
    '<path d="M7 7.5 H17 a4.5 4.5 0 0 1 4.3 5.8 L20.4 16.6 a2.4 2.4 0 0 1 -4.1 1 L14.5 15.5 H9.5 L7.7 17.6 a2.4 2.4 0 0 1 -4.1 -1 L2.7 13.3 A4.5 4.5 0 0 1 7 7.5 Z"/><path d="M7.5 10 V13.5 M5.75 11.75 H9.25"/><circle cx="15.5" cy="10.8" r="0.9"/><circle cx="17.6" cy="12.9" r="0.9"/>'
  ],
  // CLI suite: a terminal prompt
  [/\bcli\b|terminal/i, '<rect x="2.5" y="4" width="19" height="16" rx="2"/><path d="M6.5 9.5 L9.5 12 L6.5 14.5 M11.5 15 H17"/>']
];
// Neutral fallback for any other repository: an isometric package.
const FALLBACK_ICON = '<path d="M12 3 L20 7.5 V16.5 L12 21 L4 16.5 V7.5 Z M4 7.5 L12 12 L20 7.5 M12 12 V21"/>';
const projectIcon = (name: string) => PROJECT_ICONS.find(([pattern]) => pattern.test(name))?.[1] ?? FALLBACK_ICON;

// Brand glyphs (Simple Icons paths), filled with currentColor next to the GitHub and LinkedIn links.
const GITHUB_GLYPH =
  'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12';
const LINKEDIN_GLYPH =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';

const levelDots = (level: string) => t.levels[level] ?? 0;

// Hero facts, all derived from the resume: current release, its data path, credentials and services.
const currentJob = c.work[0];
const pipeline = c.nowPipeline;
const credentials = c.certificateDetails
  .filter((cert) => cert.url && cert.issuer)
  .filter((cert, index, list) => list.findIndex((other) => other.issuer === cert.issuer) === index);

// A small rack for the hero node card: three units with status LEDs.
const heroRack = [0, 1, 2].map((k) => {
  const unit = box(0, 0, k * 0.62, 2.4, 1.6, 0.5);
  const leds = [0.35, 0.6, 0.85].map((x, n) => {
    const [lx, ly] = iso(x, 1.6, k * 0.62 + 0.25);
    return { x: lx, y: ly, delay: ((k * 3 + n) * 0.41) % 2.4 };
  });
  return { ...unit, leds };
});
