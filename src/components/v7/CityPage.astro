const nowYear = new Date().getFullYear();
const firstWorkYear = Math.min(...c.work.map((job) => job.start));
const years = nowYear - firstWorkYear;
const certificates = [...c.certificateDetails].sort((a, b) => b.date.localeCompare(a.date));
const pad = (n: number) => String(n).padStart(2, '0');
const slug = (text: string) =>
  text
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

// ---------- Isometric geometry ----------
// Grid units (gx, gy, gz) project to screen with the classic 2:1 isometric ratio.
type Pt = [number, number];
const U = 30;
const COS = Math.cos(Math.PI / 6);
const iso = (gx: number, gy: number, gz = 0): Pt => [(gx - gy) * COS * U, (gx + gy) * 0.5 * U - gz * U];
const f1 = (n: number) => n.toFixed(1);
const fmt = (list: Pt[]) => list.map(([x, y]) => `${f1(x)},${f1(y)}`).join(' ');

interface Box {
  top: string;
  left: string;
  right: string;
}
/** A box with its origin corner at (gx, gy, gz), footprint w × d and height h. */
const box = (gx: number, gy: number, gz: number, w: number, d: number, h: number): Box => ({
  top: fmt([iso(gx, gy, gz + h), iso(gx + w, gy, gz + h), iso(gx + w, gy + d, gz + h), iso(gx, gy + d, gz + h)]),
  left: fmt([iso(gx, gy + d, gz + h), iso(gx + w, gy + d, gz + h), iso(gx + w, gy + d, gz), iso(gx, gy + d, gz)]),
  right: fmt([iso(gx + w, gy, gz + h), iso(gx + w, gy + d, gz + h), iso(gx + w, gy + d, gz), iso(gx + w, gy, gz)])
});

/** A storage disc: a short cylinder standing at (cx, cy, gz). */
const disc = (cx: number, cy: number, r: number, h: number, gz: number) => {
  const [bx, by] = iso(cx, cy, gz);
  const [, ty] = iso(cx, cy, gz + h);
  const rx = Math.SQRT2 * COS * r * U;
  const ry = Math.SQRT2 * 0.5 * r * U;
  return {
    body: `M ${f1(bx - rx)} ${f1(ty)} L ${f1(bx - rx)} ${f1(by)} A ${f1(rx)} ${f1(ry)} 0 0 0 ${f1(bx + rx)} ${f1(by)} L ${f1(bx + rx)} ${f1(ty)} Z`,
    band: `M ${f1(bx - rx)} ${f1((by + ty) / 2)} A ${f1(rx)} ${f1(ry)} 0 0 0 ${f1(bx + rx)} ${f1((by + ty) / 2)}`,
    cx: bx,
    ty,
    rx,
    ry,
    led: [bx - rx * 0.45, (by + ty) / 2 + ry * 0.75] as Pt
  };
};

// Each layer of the method is one piece of infrastructure.
// Boxes: [gx, gy, w, d, h, gz?] plus rack units and status LEDs; discs: [cx, cy, r, h, gz].
type BoxPart = { type: 'box'; g: [number, number, number, number, number, number?]; units?: number; leds?: boolean };
type DiscPart = { type: 'disc'; g: [number, number, number, number, number] };
type Part = BoxPart | DiscPart;
const slab = (gx: number, gy: number, w: number, d: number, gz: number): BoxPart => ({
  type: 'box',
  g: [gx, gy, w, d, 0.42, gz],
  leds: true
});
const STAGE_PARTS: Part[][] = [
  // 1 · domain sources: stacks of application servers
  [
    slab(1, 9.4, 1.5, 1.5, 0),
    slab(1, 9.4, 1.5, 1.5, 0.52),
    slab(3.1, 9.8, 1.2, 1.2, 0),
    slab(1.3, 11.4, 1.3, 1.2, 0),
    slab(1.3, 11.4, 1.3, 1.2, 0.52),
    slab(1.3, 11.4, 1.3, 1.2, 1.04)
  ],
  // 2 · ingestion: a gateway with connector pods on top
  [
    { type: 'box', g: [5.6, 9.3, 3, 2.3, 0.55] },
    { type: 'box', g: [5.85, 9.55, 0.75, 0.75, 0.75, 0.55], leds: true },
    { type: 'box', g: [6.9, 9.55, 0.75, 0.75, 0.95, 0.55], leds: true },
    { type: 'box', g: [7.95, 9.55, 0.4, 0.75, 0.6, 0.55], leds: true },
    { type: 'box', g: [5.85, 10.6, 1.8, 0.75, 0.5, 0.55], leds: true }
  ],
  // 3 · event backbone: broker racks
  [
    { type: 'box', g: [7.3, 4.8, 1.3, 1.5, 2.7], units: 9, leds: true },
    { type: 'box', g: [9.1, 4.8, 1.3, 1.5, 2.7], units: 9, leds: true },
    { type: 'box', g: [10.9, 4.8, 1.3, 1.5, 2.7], units: 9, leds: true }
  ],
  // 4 · processing: a node pool on a cluster base
  [
    { type: 'box', g: [12.7, 4.4, 2.7, 2.7, 0.3] },
    { type: 'box', g: [12.9, 4.6, 1.05, 1.05, 1.1, 0.3], units: 2, leds: true },
    { type: 'box', g: [14.15, 4.6, 1.05, 1.05, 1.6, 0.3], units: 3, leds: true },
    { type: 'box', g: [12.9, 5.85, 1.05, 1.05, 0.8, 0.3], units: 2, leds: true },
    { type: 'box', g: [14.15, 5.85, 1.05, 1.05, 1.3, 0.3], units: 2, leds: true }
  ],
  // 5 · storage and serving: stacked volumes
  [
    { type: 'disc', g: [14.6, 1.8, 0.8, 0.55, 0] },
    { type: 'disc', g: [14.6, 1.8, 0.8, 0.55, 0.68] },
    { type: 'disc', g: [14.6, 1.8, 0.8, 0.55, 1.36] },
    { type: 'disc', g: [16.5, 1.6, 0.75, 0.55, 0] },
    { type: 'disc', g: [16.5, 1.6, 0.75, 0.55, 0.68] },
    { type: 'disc', g: [15.6, 3.4, 0.7, 0.55, 0] }
  ],
  // 6 · observability: a monitoring tower with a live screen
  [
    { type: 'box', g: [19.3, 1.4, 1.3, 1.3, 0.4], leds: true },
    { type: 'box', g: [19.8, 1.95, 0.3, 0.3, 2.6, 0.4] },
    { type: 'box', g: [19.0, 1.75, 1.9, 0.2, 1.15, 3.0] }
  ],
  // 7 · consumers: Go service pods behind an API gateway
  [
    { type: 'box', g: [18.3, -2.1, 3.6, 1.1, 0.35], leds: true },
    { type: 'box', g: [18.5, -4.0, 1.1, 1.1, 0.95], units: 2, leds: true },
    { type: 'box', g: [19.95, -3.95, 0.9, 0.9, 1.3], units: 2, leds: true },
    { type: 'box', g: [21.1, -4.0, 0.8, 1.1, 0.7], leds: true }
  ]
];
// Namespaces for the service labels; the service name comes from each layer's first technology.
const NAMESPACES = ['src', 'ingest', 'stream', 'proc', 'store', 'obs', 'serve'];

let ledSeed = 0;
const stages = c.stages.slice(0, STAGE_PARTS.length).map((stage, index) => {
  const parts = STAGE_PARTS[index];
  const tops: number[] = [];
  const xs: number[] = [];
  const ys: number[] = [];
  const shapes = parts
    .map((part) => {
      if (part.type === 'disc') {
        const [cx, cy, r, h, gz] = part.g;
        tops.push(gz + h);
        xs.push(cx - r, cx + r);
        ys.push(cy - r, cy + r);
        ledSeed += 1;
        return { kind: 'disc' as const, z: gz, depth: cx + cy + 2 * r, ...disc(cx, cy, r, h, gz), delay: (ledSeed * 0.37) % 2.4 };
      }
      const [gx, gy, w, d, h, gz = 0] = part.g;
      tops.push(gz + h);
      xs.push(gx, gx + w);
      ys.push(gy, gy + d);
      const units = part.units ?? 1;
      const lines: string[] = [];
      for (let k = 1; k < units; k += 1) {
        const z = gz + (h * k) / units;
        lines.push(fmt([iso(gx, gy + d, z), iso(gx + w, gy + d, z)]));
        lines.push(fmt([iso(gx + w, gy, z), iso(gx + w, gy + d, z)]));
      }
      const leds: { x: number; y: number; delay: number }[] = [];
      if (part.leds) {
        for (let k = 0; k < units; k += 1) {
          const [x, y] = iso(gx + Math.min(0.28, w * 0.22), gy + d, gz + (h * (k + 0.5)) / units);
          ledSeed += 1;
          leds.push({ x, y, delay: (ledSeed * 0.37) % 2.4 });
        }
      }
      return { kind: 'box' as const, z: gz, depth: gx + w + gy + d, ...box(gx, gy, gz, w, d, h), lines, leds };
    })
    // Painter's order: lower levels first, then far before near.
    .sort((a, b) => a.z - b.z || a.depth - b.depth);
  const ax = (Math.min(...xs) + Math.max(...xs)) / 2;
  const ay = (Math.min(...ys) + Math.max(...ys)) / 2;
  const height = Math.max(...tops);
  const [pinX, pinY] = iso(ax, ay, height + 1.1);
  const [, baseY] = iso(ax, ay, height + 0.1);
  const service = `${NAMESPACES[index] ?? 'svc'}/${slug(stage.tech[0] ?? stage.name)}`;
  return {
    ...stage,
    index,
    service,
    shapes,
    pin: { x: pinX, y: pinY, baseY },
    // The monitoring screen draws a live chart and carries a beacon.
    screen:
      index === 5
        ? {
            spark: fmt(
              [0.1, 0.35, 0.25, 0.55, 0.42, 0.7, 0.5, 0.85, 0.62].map((v, k) =>
                iso(19.15 + (k * 1.6) / 8, 1.95, 3.15 + v * 0.85)
              )
            ),
            beacon: iso(19.95, 1.85, 4.3)
          }
        : null,
    depth: ax + ay
  };
});

// Platform: stepped zones that follow the flow. Sides first, then tops, so the tops merge.
const ZONES: [number, number, number, number, string][] = [
  [0, 8.1, 10.8, 5, 'ZONE A · EDGE'],
  [6.2, 3.5, 11.2, 5, 'ZONE B · STREAM'],
  [12.8, -0.6, 9.8, 4.6, 'ZONE C · DATA'],
  [17.4, -5, 5.2, 4.8, 'ZONE D · SERVE']
];
const ZONE_H = 0.45;
const platform = ZONES.map(([gx, gy, w, d]) => box(gx, gy, -ZONE_H, w, d, ZONE_H));
// Zone labels lie flat on the platform, written along the x axis.
const zoneLabels = ZONES.map(([gx, gy, , d, label]) => {
  const [x, y] = iso(gx + 0.35, gy + d - 0.35, 0);
  return { label, transform: `matrix(${COS.toFixed(4)} 0.5 ${(-COS).toFixed(4)} 0.5 ${f1(x)} ${f1(y)})` };
});

// Grid lines on the platform, clipped to its tops.
const gridLines: string[] = [];
for (let gx = 0; gx <= 23; gx += 1) gridLines.push(fmt([iso(gx, -5), iso(gx, 13.1)]));
for (let gy = -5; gy <= 13; gy += 1) gridLines.push(fmt([iso(0, gy), iso(22.6, gy)]));

// Data link: a Manhattan route through every layer, slightly above the platform.
const ROUTE: Pt[] = [
  [2.2, 10.6],
  [7.1, 10.6],
  [9.8, 10.6],
  [9.8, 5.55],
  [14, 5.55],
  [15.5, 5.55],
  [15.5, 2.5],
  [19.95, 2.5],
  [19.95, -1.55],
  [20.6, -1.55]
];
const link = `M ${ROUTE.map(([gx, gy]) => iso(gx, gy, 0.02).map(f1).join(' ')).join(' L ')}`;

// Idle nodes around the layers: the rest of the cluster.
const IDLE: [number, number, number, number, number][] = [
  [8.9, 7.3, 1.1, 0.9, 0.5],
  [6.7, 3.9, 1.2, 0.8, 0.42],
  [12.9, 0, 1.2, 0.9, 0.7],
  [17.6, 6.3, 1.1, 1.1, 0.5],
  [4.6, 12.3, 0.9, 0.7, 0.42],
  [21.6, 3.3, 0.8, 0.8, 0.5]
];
const idle = IDLE.map(([gx, gy, w, d, h], index) => {
  const [lx, ly] = iso(gx + 0.25, gy + d, h / 2);
  return { ...box(gx, gy, 0, w, d, h), led: [lx, ly] as Pt, depth: gx + w + gy + d, delay: (index * 0.53) % 2.4 };
});

type Drawable =
  | { kind: 'stage'; depth: number; stage: (typeof stages)[number] }
  | { kind: 'idle'; depth: number; node: (typeof idle)[number] };
const scene: Drawable[] = [
  ...stages.map((stage) => ({ kind: 'stage' as const, depth: stage.depth, stage })),
  ...idle.map((node) => ({ kind: 'idle' as const, depth: node.depth - 1, node }))
].sort((a, b) => a.depth - b.depth);

// The view box hugs the model.
const bounds = (() => {
  const xs: number[] = [];
  const ys: number[] = [];
  ZONES.forEach(([gx, gy, w, d]) =>
    [iso(gx, gy, 0), iso(gx + w, gy, 0), iso(gx, gy + d, 0), iso(gx + w, gy + d, -ZONE_H)].forEach(([x, y]) => {
      xs.push(x);
      ys.push(y);
    })
  );
  stages.forEach((stage) => ys.push(stage.pin.y - 16));
  return {
    x: Math.min(...xs) - 12,
    y: Math.min(...ys) - 8,
    w: Math.max(...xs) - Math.min(...xs) + 24,
    h: Math.max(...ys) - Math.min(...ys) + 26
  };
})();
const viewBox = `${bounds.x.toFixed(0)} ${bounds.y.toFixed(0)} ${bounds.w.toFixed(0)} ${bounds.h.toFixed(0)}`;
const packet = box(-0.2, -0.2, 0.05, 0.4, 0.4, 0.26);

// ---------- Releases (work) and base image (education) ----------
const releases = [...c.work].sort((a, b) => b.start - a.start);
const layers = [...c.education].sort((a, b) => b.start - a.start);
// A short, stable hash so every layer looks like an image digest.
const digest = (text: string) => {
  let h = 2166136261;
  for (const ch of text) h = Math.imul(h ^ ch.charCodeAt(0), 16777619);
  return (h >>> 0).toString(16).padStart(8, '0').slice(0, 7);
};

// ---------- Projects ----------
const tagCounts = new Map<string, number>();
c.projects.forEach((project) => project.allTags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1)));
const PRIMARY_TAGS = 10;
const allTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).map(([tag]) => tag);
// A small stack per project; one layer for every two topics it covers.
const serviceIcon = (n: number) => {
  const count = Math.max(1, Math.min(4, Math.ceil(n / 2)));
  const slabs = Array.from({ length: count }, (_, k) => box(0, 0, k * 0.42, 1, 1, 0.32));
  const [, minY] = iso(0, 0, (count - 1) * 0.42 + 0.32);
  return { slabs, viewBox: `-28 ${(minY - 4).toFixed(0)} 56 ${(34 - minY + 4).toFixed(0)}` };
};

const levelDots = (level: string) => t.levels[level] ?? 0;
---

<html lang={locale}>
  <head>
    <SeoHead
      title={seo.title}
      description={seo.description}
      canonical={seo.canonical}
      ogLocale={seo.ogLocale}
      ogLocaleAlternate={seo.ogLocaleAlternate}
      ogTitle={seo.ogTitle}
      ogDescription={seo.ogDescription}
      alternates={getAlternateLinks()}
      noindex
    />
    <link rel="preload" href="/assets/fonts/mona-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0a0d13" />
  </head>
  <body class="cy">
    <a class="cy-skip" href="#main">{t.skip}</a>

    <header class="cy-bar">
      <a class="cy-brand" href={t.home} aria-label="David Barreiro">
        <svg viewBox="-13 -15 26 30" width="24" height="28" aria-hidden="true">
          <polygon points="0,-13 11.3,-6.5 0,0 -11.3,-6.5" fill="#c6f432"></polygon>
          <polygon points="-11.3,-6.5 0,0 0,13 -11.3,6.5" fill="#2a3548"></polygon>
          <polygon points="0,0 11.3,-6.5 11.3,6.5 0,13" fill="#1a2230"></polygon>
        </svg>
        <span>david<b>/</b>barreiro</span>
      </a>
      <nav class="cy-nav" aria-label={t.sections}>
        <a href="#topologia">{t.nav.topology}</a>
        <a href="#despliegues">{t.nav.deploys}</a>
        <a href="#servicios">{t.nav.services}</a>
        <a href="#stack">{t.nav.stack}</a>
      </nav>
      <div class="cy-bar-end">
        <div class="cy-lang" role="group" aria-label={t.langLabel}>
          <a href="/v7/" hreflang="en" lang="en" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
          <a href="/es/v7/" hreflang="es" lang="es" aria-current={locale === 'es' ? 'page' : undefined}>ES</a>
        </div>
        <a class="cy-btn cy-btn-sm" href="#contacto">{t.nav.contact}</a>
      </div>
    </header>

    <main id="main">
      <!-- ============ HERO + TOPOLOGY ============ -->
      <section class="cy-hero" id="topologia" aria-labelledby="cy-title">
        <div class="cy-hero-copy">
          <p class="cy-role"><span class="cy-status" aria-hidden="true"></span>{t.role} · {t.available}</p>
          <h1 id="cy-title" class="cy-name">David<br />Barreiro</h1>
          <p class="cy-headline">{t.headline}</p>
          <p class="cy-lede">{t.lede(years)}</p>
          <div class="cy-actions">
            <a class="cy-btn" href={`mailto:${c.email}`}>{t.contact}</a>
            <details class="cy-cv" data-cv>
              <summary class="cy-btn cy-btn-line">{t.cv}</summary>
              <ul>
                {
                  c.cvOptions.map((option) => (
                    <li>
                      <a href={option.href} target="_blank" rel="noopener noreferrer">
                        <strong>{t.cvOptions[option.key][0]}</strong>
                        <span>{t.cvOptions[option.key][1]}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
          </div>
          <dl class="cy-stats">
            <div><dt>{t.statYears}</dt><dd>{years}</dd></div>
            <div><dt>{t.statCerts}</dt><dd>{certificates.length}</dd></div>
            <div><dt>{t.statStages}</dt><dd>{stages.length}</dd></div>
          </dl>
          <p class="cy-links">
            <a href={c.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href={c.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          </p>
        </div>

        <div class="cy-model">
          <div class="cy-model-head">
            <div>
              <h2>{t.modelTitle}</h2>
              <p>{t.modelHint}</p>
            </div>
            <button
              type="button"
              class="cy-pause"
              data-pause
              aria-pressed="false"
              data-label-pause={t.pause}
              data-label-resume={t.resume}
            >
              <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" class="cy-pause-icon">
                <rect x="3" y="2" width="3.5" height="12" rx="1"></rect>
                <rect x="9.5" y="2" width="3.5" height="12" rx="1"></rect>
              </svg>
              <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" class="cy-play-icon">
                <path d="M4 2.5 L13.5 8 L4 13.5 Z"></path>
              </svg>
              <span data-pause-text>{t.pause}</span>
            </button>
          </div>

          <svg class="cy-scene" viewBox={viewBox} role="group" aria-label={t.modelTitle} data-scene>
            <defs>
              <filter id="cy-soft" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="9"></feGaussianBlur>
              </filter>
              <filter id="cy-glow" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="3"></feGaussianBlur>
              </filter>
              <clipPath id="cy-zone-clip">
                {platform.map((zone) => <polygon points={zone.top} />)}
              </clipPath>
              <linearGradient id="cy-disc" x1="0" x2="1" y1="0" y2="0">
                <stop offset="0" stop-color="#2c3850"></stop>
                <stop offset="0.55" stop-color="#1d2738"></stop>
                <stop offset="1" stop-color="#121925"></stop>
              </linearGradient>
              <linearGradient id="cy-disc-active" x1="0" x2="1" y1="0" y2="0">
                <stop offset="0" stop-color="#d9ff6b"></stop>
                <stop offset="0.55" stop-color="#a9d21f"></stop>
                <stop offset="1" stop-color="#7a9a12"></stop>
              </linearGradient>
              <path id="cy-route" d={link}></path>
            </defs>

            <!-- platform glow and zones -->
            <g class="cy-under" filter="url(#cy-soft)">
              {platform.map((zone) => <polygon points={zone.top} transform="translate(0 22)" />)}
            </g>
            <g class="cy-platform">
              {
                platform.map((zone) => (
                  <>
                    <polygon class="cy-face-left" points={zone.left} />
                    <polygon class="cy-face-right" points={zone.right} />
                  </>
                ))
              }
              {platform.map((zone) => <polygon class="cy-face-top" points={zone.top} />)}
            </g>
            <g class="cy-grid" clip-path="url(#cy-zone-clip)">
              {gridLines.map((points) => <polyline points={points} />)}
            </g>
            <g class="cy-zone-labels" aria-hidden="true">
              {zoneLabels.map((zone) => <text transform={zone.transform}>{zone.label}</text>)}
            </g>

            <!-- data link with moving packets -->
            <path class="cy-link-bed" d={link}></path>
            <path class="cy-link-glow" d={link} filter="url(#cy-glow)"></path>
            <path class="cy-link" d={link}></path>
            {
              [0, 1, 2, 3, 4, 5, 6, 7].map((n) => (
                <g class="cy-packet">
                  <polygon class="cy-packet-l" points={packet.left} />
                  <polygon class="cy-packet-r" points={packet.right} />
                  <polygon class="cy-packet-t" points={packet.top} />
                  <animateMotion dur="14s" begin={`${n * -1.75}s`} repeatCount="indefinite">
                    <mpath href="#cy-route" />
                  </animateMotion>
                </g>
              ))
            }

            <!-- layers and idle nodes, back to front -->
            {
              scene.map((item) => {
                if (item.kind === 'idle') {
                  const node = item.node;
                  return (
                    <g class="cy-idle">
                      <polygon class="cy-face-left" points={node.left} />
                      <polygon class="cy-face-right" points={node.right} />
                      <polygon class="cy-face-top" points={node.top} />
                      <circle class="cy-led cy-led-dim" cx={f1(node.led[0])} cy={f1(node.led[1])} r="1.6" style={`--d:${node.delay.toFixed(2)}s`} />
                    </g>
                  );
                }
                const stage = item.stage;
                return (
                  <g
                    class="cy-node"
                    data-stage={stage.index}
                    tabindex="0"
                    role="button"
                    aria-label={`${pad(stage.index + 1)}. ${stage.name} (${stage.service})`}
                  >
                    <g class="cy-node-body">
                      {stage.shapes.map((shape) =>
                        shape.kind === 'box' ? (
                          <>
                            <polygon class="cy-face-left" points={shape.left} />
                            <polygon class="cy-face-right" points={shape.right} />
                            <polygon class="cy-face-top" points={shape.top} />
                            {shape.lines.map((points) => (
                              <polyline class="cy-unit" points={points} />
                            ))}
                            {shape.leds.map((led) => (
                              <circle class="cy-led" cx={f1(led.x)} cy={f1(led.y)} r="1.7" style={`--d:${led.delay.toFixed(2)}s`} />
                            ))}
                          </>
                        ) : (
                          <>
                            <path class="cy-disc-body" d={shape.body} />
                            <path class="cy-unit" d={shape.band} fill="none" />
                            <ellipse class="cy-face-top" cx={f1(shape.cx)} cy={f1(shape.ty)} rx={f1(shape.rx)} ry={f1(shape.ry)} />
                            <circle class="cy-led" cx={f1(shape.led[0])} cy={f1(shape.led[1])} r="1.7" style={`--d:${shape.delay.toFixed(2)}s`} />
                          </>
                        )
                      )}
                      {stage.screen && (
                        <>
                          <polyline class="cy-spark" points={stage.screen.spark} />
                          <circle class="cy-beacon-halo" cx={f1(stage.screen.beacon[0])} cy={f1(stage.screen.beacon[1])} r="10" />
                          <circle class="cy-beacon" cx={f1(stage.screen.beacon[0])} cy={f1(stage.screen.beacon[1])} r="3.6" />
                        </>
                      )}
                    </g>
                    <g class="cy-pin">
                      <line x1={f1(stage.pin.x)} y1={f1(stage.pin.y + 11)} x2={f1(stage.pin.x)} y2={f1(stage.pin.baseY)} />
                      <g transform={`translate(${f1(stage.pin.x)} ${f1(stage.pin.y)})`}>
                        <g class="cy-pin-badge">
                          <rect x="-15" y="-10" width="30" height="20" rx="4" />
                          <text y="4" text-anchor="middle">
                            {pad(stage.index + 1)}
                          </text>
                        </g>
                      </g>
                    </g>
                  </g>
                );
              })
            }
          </svg>

          <div class="cy-model-foot">
            <div class="cy-card" aria-live="off" data-card>
              <p class="cy-card-meta">
                <span class="cy-card-num" data-card-num>01</span>
                <span data-card-meta>{t.stageOf(1, stages.length)}</span>
                <span class="cy-card-health"><i aria-hidden="true"></i>{t.healthy}</span>
              </p>
              <p class="cy-card-name" data-card-name>{stages[0].name}</p>
              <p class="cy-card-service" data-card-service>{stages[0].service}</p>
              <p class="cy-card-detail" data-card-detail>{stages[0].detail}</p>
              <p class="cy-card-tech">
                <span class="cy-card-tech-label">{t.builtWith}</span>
                <span class="cy-card-chips" data-card-tech>
                  {stages[0].tech.map((tech) => <span>{tech}</span>)}
                </span>
              </p>
            </div>
            <div class="cy-telemetry" data-telemetry>
              <p class="cy-telemetry-head">
                <span class="cy-status" aria-hidden="true"></span>{t.telemetry}
              </p>
              <dl>
                <div>
                  <dt>{t.metrics.eps}</dt>
                  <dd data-metric="eps">48.2k</dd>
                </div>
                <div>
                  <dt>{t.metrics.p99}</dt>
                  <dd data-metric="p99">14 ms</dd>
                </div>
                <div>
                  <dt>{t.metrics.lag}</dt>
                  <dd data-metric="lag">0</dd>
                </div>
                <div>
                  <dt>{t.metrics.up}</dt>
                  <dd>{stages.length}/{stages.length}</dd>
                </div>
              </dl>
              <svg class="cy-telemetry-chart" viewBox="0 0 240 48" preserveAspectRatio="none" aria-hidden="true">
                <polyline data-chart points="0,30 240,30"></polyline>
              </svg>
            </div>
          </div>

          <ol class="cy-key" aria-label={t.key}>
            {
              stages.map((stage) => (
                <li>
                  <button type="button" data-stage={stage.index} aria-pressed={stage.index === 0 ? 'true' : 'false'}>
                    <span class="cy-key-num">{pad(stage.index + 1)}</span>
                    <span class="cy-key-name">{stage.name}</span>
                  </button>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- ============ RELEASES: work experience ============ -->
      <section class="cy-section" id="despliegues" aria-labelledby="deploys-title">
        <div class="cy-section-head">
          <p class="cy-eyebrow">{t.deploysEyebrow}</p>
          <h2 id="deploys-title">{t.deploysTitle}</h2>
          <p>{t.deploysIntro}</p>
        </div>
        <div class="cy-section-body">
          <ol class="cy-releases">
            {
              releases.map((entry, index) => (
                <li class:list={{ 'is-live': entry.end === null }}>
                  <span class="cy-release-dot" aria-hidden="true" />
                  <details open={index === 0}>
                    <summary>
                      <span class="cy-release-tag">v{releases.length - index}.0</span>
                      <span class="cy-release-period">{entry.period}</span>
                      <span class="cy-release-org">{entry.organisation}</span>
                      <span class="cy-release-role">{entry.role}</span>
                      <span class="cy-release-state">{entry.end === null ? t.running : t.done}</span>
                    </summary>
                    <div class="cy-release-body">
                      {entry.summary && <p>{entry.summary}</p>}
                      {entry.highlights.length > 0 && (
                        <>
                          <h3>{t.highlights}</h3>
                          <ul>
                            {entry.highlights.map((item) => (
                              <li>{item}</li>
                            ))}
                          </ul>
                        </>
                      )}
                      {entry.tech.length > 0 && (
                        <p class="cy-chips">
                          {entry.tech.map((tech) => (
                            <span>{tech}</span>
                          ))}
                        </p>
                      )}
                    </div>
                  </details>
                </li>
              ))
            }
          </ol>
          <div class="cy-image">
            <h3 class="cy-image-title">
              <span aria-hidden="true">$</span>
              {t.baseTitle}
            </h3>
            <ol class="cy-layers">
              {
                layers.map((entry, index) => (
                  <li>
                    <span class="cy-layer-id" aria-hidden="true">
                      {t.layer} {pad(layers.length - index)} · {digest(entry.organisation + entry.role)}
                    </span>
                    <span class="cy-layer-period">{entry.period}</span>
                    <div>
                      <p class="cy-layer-org">{entry.organisation}</p>
                      <p class="cy-layer-role">{entry.role}</p>
                      {entry.tech.length > 0 && <p class="cy-layer-tech">{entry.tech.join(' · ')}</p>}
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <!-- ============ SERVICES: projects ============ -->
      <section class="cy-section" id="servicios" aria-labelledby="services-title" data-projects>
        <div class="cy-section-head">
          <p class="cy-eyebrow">{t.servicesEyebrow}</p>
          <h2 id="services-title">{t.servicesTitle}</h2>
          <p>{t.servicesIntro}</p>
        </div>
        <div class="cy-section-body">
          <div class="cy-filter" role="group" aria-label={t.filterLabel}>
            <button type="button" class="cy-chip" data-tag="" aria-pressed="true">{t.filterAll}</button>
            {
              allTags.map((tag, index) => (
                <button
                  type="button"
                  class:list={['cy-chip', { 'is-extra': index >= PRIMARY_TAGS }]}
                  data-tag={tag}
                  aria-pressed="false"
                >
                  {tag}
                </button>
              ))
            }
            {
              allTags.length > PRIMARY_TAGS && (
                <button
                  type="button"
                  class="cy-more"
                  data-more
                  aria-expanded="false"
                  data-label-more={t.moreTopics(allTags.length - PRIMARY_TAGS)}
                  data-label-less={t.lessTopics}
                >
                  {t.moreTopics(allTags.length - PRIMARY_TAGS)}
                </button>
              )
            }
          </div>
          <p class="cy-filter-status">
            <span data-count>{t.showing(c.projects.length, c.projects.length)}</span>
            <button type="button" class="cy-clear" data-clear hidden>{t.clear}</button>
          </p>
          <ol class="cy-services">
            {
              c.projects.map((project, index) => {
                const icon = serviceIcon(project.allTags.length);
                return (
                  <li data-tags={JSON.stringify(project.allTags)}>
                    <div class="cy-service-head">
                      <svg class="cy-service-icon" viewBox={icon.viewBox} width="40" height="38" aria-hidden="true">
                        {icon.slabs.map((s) => (
                          <>
                            <polygon class="cy-face-left" points={s.left} />
                            <polygon class="cy-face-right" points={s.right} />
                            <polygon class="cy-face-top" points={s.top} />
                          </>
                        ))}
                      </svg>
                      <span class="cy-service-id">
                        svc-{pad(index + 1)} · {slug(project.name)}
                      </span>
                    </div>
                    <h3>
                      {project.url ? (
                        <a href={project.url} target="_blank" rel="noopener noreferrer">
                          {project.name}
                          <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" class="cy-ext">
                            <path d="M3 9 L9 3 M4 3 H9 V8" fill="none" stroke="currentColor" stroke-width="1.6" />
                          </svg>
                          <span class="cy-sr">({t.repo})</span>
                        </a>
                      ) : (
                        project.name
                      )}
                    </h3>
                    <p>{project.oneLiner}</p>
                    <p class="cy-tags">
                      {project.allTags.map((tag) => (
                        <span>{tag}</span>
                      ))}
                    </p>
                  </li>
                );
              })
            }
          </ol>
          <p class="cy-empty" data-empty hidden>{t.empty}</p>
        </div>
      </section>

      <!-- ============ STACK: skills ============ -->
      <section class="cy-section" id="stack" aria-labelledby="stack-title">
        <div class="cy-section-head">
          <p class="cy-eyebrow">{t.stackEyebrow}</p>
          <h2 id="stack-title">{t.stackTitle}</h2>
          <p>{t.stackIntro}</p>
        </div>
        <div class="cy-section-body">
          <div class="cy-tabs" role="tablist" aria-label={t.stackTitle}>
            {
              c.skillGroups.map((group, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`mat-tab-${index}`}
                  aria-controls={`mat-panel-${index}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  tabindex={index === 0 ? 0 : -1}
                >
                  <span class="cy-tab-num">L{index + 1}</span>
                  {group.name}
                </button>
              ))
            }
          </div>
          {
            c.skillGroups.map((group, index) => (
              <div class="cy-panel" role="tabpanel" id={`mat-panel-${index}`} aria-labelledby={`mat-tab-${index}`} hidden={index !== 0}>
                <ul class="cy-skills">
                  {group.keywords.map((skill) => (
                    <li>
                      {skill.logo ? (
                        <img src={skill.logo} alt="" width="32" height="32" loading="lazy" />
                      ) : (
                        <span class="cy-skill-ph" aria-hidden="true" />
                      )}
                      <div>
                        <p class="cy-skill-name">{skill.name}</p>
                        <p class="cy-skill-level">
                          <span class="cy-meter" aria-hidden="true">
                            {[1, 2, 3].map((n) => (
                              <i class:list={{ on: n <= levelDots(skill.level) }} />
                            ))}
                          </span>
                          {skill.level}
                        </p>
                        {skill.certifications.map((cert) => (
                          <a class="cy-cert" href={cert.url} target="_blank" rel="noopener noreferrer">
                            {t.certified} · {cert.issuer}
                          </a>
                        ))}
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          <div class="cy-certs-head">
            <h3>{t.certsTitle}</h3>
            <span>{t.certsNote}</span>
          </div>
          <ul class="cy-certs">
            {
              certificates.map((cert) => (
                <li>
                  {cert.date && <span class="cy-cert-year">{cert.date.slice(0, 4)}</span>}
                  {cert.url ? (
                    <a href={cert.url} target="_blank" rel="noopener noreferrer">
                      {cert.name}
                    </a>
                  ) : (
                    <span>{cert.name}</span>
                  )}
                  <span class="cy-cert-issuer">{cert.issuer}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ============ CONTACT: open a connection ============ -->
      <section class="cy-contact" id="contacto" aria-labelledby="contact-title">
        <div class="cy-contact-inner">
          <div>
            <p class="cy-eyebrow">{t.contactEyebrow}</p>
            <h2 id="contact-title">{t.contactTitle}</h2>
            <p>{t.contactText}</p>
            <div class="cy-actions">
              <a class="cy-btn cy-btn-accent" href={`mailto:${c.email}`}>{c.email}</a>
              <a class="cy-btn cy-btn-line" href={c.cvUrl} target="_blank" rel="noopener noreferrer">{t.cv}</a>
            </div>
            <p class="cy-links">
              <a href={c.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
              <a href={c.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
            </p>
          </div>
          <pre class="cy-terminal" aria-hidden="true"><span class="cy-t-dim">~/platform</span> <span class="cy-t-acc">$</span> connect --to david-barreiro
<span class="cy-t-ok">✓</span> {t.terminalOk}
<span class="cy-t-dim">~/platform</span> <span class="cy-t-acc">$</span> <span class="cy-caret"></span></pre>
        </div>
      </section>
    </main>

    <footer class="cy-footer">
      <p>© {nowYear} {c.name} · {t.footerRole}</p>
    </footer>

    <script
      is:inline
      type="application/json"
      id="cy-data"
      set:html={JSON.stringify({
        stages: stages.map((stage) => ({ name: stage.name, detail: stage.detail, tech: stage.tech, service: stage.service })),
        labels: {
          stage: t.stageOf(0, 0).replace(/\d+/g, '{n}'),
          showing: t.showing(0, 0).replace(/\d+/g, '{n}')
        }
      })}
    />
    <script>
      import './city.ts';
    </script>
  </body>
</html>
