      { id: 'theme-infra', label: `${t.cmd.theme}: ${t.cmd.themeInfra}`, meta: '/live/', keywords: 'theme tema infra isometric isométrica', icon: 'swatch', href: `${prefix}/live/`, action: 'go' },
      { id: 'theme-poster', label: `${t.cmd.theme}: ${t.cmd.themePoster}`, meta: '/editorial/', keywords: 'theme tema poster cartel swiss suizo', icon: 'swatch', href: `${prefix}/editorial/`, action: 'go' }
