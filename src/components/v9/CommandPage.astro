const nowYear = new Date().getFullYear();
const firstWorkYear = Math.min(...c.work.map((job) => job.start));
const years = nowYear - firstWorkYear;
const certificates = [...c.certificateDetails].sort((a, b) => b.date.localeCompare(a.date));
const work = [...c.work].sort((a, b) => b.start - a.start);
const education = [...c.education].sort((a, b) => b.start - a.start);
const pad = (n: number) => String(n).padStart(2, '0');
const prefix = locale === 'es' ? '/es' : '';

/* ---- Hero: the same kicker, name and summary as the main site ---- */
const basics = getResume(locale).basics;
const summary = String(basics.summary || '')
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
// Same rule as the main site's "Core Skills" metric: skills at an advanced level.
const coreSkills = c.skillGroups
  .flatMap((group) => group.keywords)
  .filter((skill) => {
    const value = skill.level.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    return value.includes('advanced') || value.includes('avanzado');
  }).length;

// resume.json mixes case and has a typo ("Intemediate"); read levels by prefix.
const levelValue = (level: string) => {
  const value = level.trim().toLowerCase();
  if (value.startsWith('exp')) return 3;
  if (value.startsWith('adv') || value.startsWith('avan')) return 2;
  if (value.startsWith('int')) return 1;
  return 0;
};

/* ---- Project topics: the most frequent first ---- */
const PRIMARY_TAGS = 10;
const tagCounts = new Map<string, number>();
c.projects.forEach((project) =>
  project.allTags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1))
);
const allTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag]) => tag);

const slug = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

/* ---- Release numbers: the oldest role is v1 ---- */
const releaseOf = (index: number) => `v${work.length - index}.0`;

/* ---- Command palette content ---- */
const groups: CommandGroup[] = [
  {
    key: 'navigate',
    label: t.groups.navigate,
    items: [
      { id: 'nav-capabilities', label: t.capabilitiesTitle, meta: t.cmd.section, keywords: 'backend data platform', icon: 'hash', href: '#capabilities', action: 'go' },
      { id: 'nav-portfolio', label: t.portfolioKicker, meta: t.portfolioTitle, keywords: 'projects repos github proyectos', icon: 'hash', href: '#portfolio', action: 'go' },
      { id: 'nav-system-design', label: t.systemKicker, meta: t.systemTitle, keywords: 'pipeline method architecture', icon: 'hash', href: '#system-design', action: 'go' },
      { id: 'nav-experience', label: t.timelineKicker, meta: t.timelineTitle, keywords: 'jobs career work experience', icon: 'hash', href: '#experience', action: 'go' },
      { id: 'nav-skills', label: t.skillsKicker, meta: t.skillsTitle, keywords: 'stack skills certifications', icon: 'hash', href: '#skills', action: 'go' },
      { id: 'nav-contact', label: t.contactKicker, meta: t.contactTitle, keywords: 'email hire', icon: 'hash', href: '#contact', action: 'go' }
    ]
  },
  {
    key: 'actions',
    label: t.groups.actions,
    items: [
      ...c.cvOptions.map((option) => ({
        id: `cv-${option.key}`,
        label: `${t.cmd.cv} · ${t.cvOptions[option.key][0]}`,
        meta: 'PDF',
        keywords: 'cv resume curriculum pdf',
        icon: 'download' as const,
        href: option.href,
        action: 'go' as const,
        external: true
      })),
      { id: 'copy-email', label: t.cmd.copy, meta: c.email, keywords: 'email mail contact', icon: 'copy', href: `mailto:${c.email}`, action: 'copy', value: c.email },
      { id: 'mail', label: t.cmd.mail, meta: c.email, keywords: 'email mail contact', icon: 'mail', href: `mailto:${c.email}`, action: 'go' },
      { id: 'lang', label: t.cmd.lang, meta: t.other.code, keywords: 'language idioma english español', icon: 'globe', href: t.other.href, action: 'go' },
      { id: 'github', label: 'GitHub', meta: c.githubUrl.replace(/^https?:\/\//, ''), keywords: 'code repos', icon: 'link', href: c.githubUrl, action: 'go', external: true },
      { id: 'linkedin', label: 'LinkedIn', meta: c.linkedinUrl.replace(/^https?:\/\/(www\.)?/, ''), keywords: 'profile', icon: 'link', href: c.linkedinUrl, action: 'go', external: true }
    ]
  },
  {
    key: 'theme',
    label: t.groups.theme,
    items: [
      { id: 'theme-poster', label: `${t.cmd.theme}: ${t.cmd.themePoster}`, meta: '/v6/', keywords: 'theme tema poster cartel swiss suizo', icon: 'swatch', href: `${prefix}/v6/`, action: 'go' },
      { id: 'theme-infra', label: `${t.cmd.theme}: ${t.cmd.themeInfra}`, meta: '/v7/', keywords: 'theme tema infra isometric isométrica', icon: 'swatch', href: `${prefix}/v7/`, action: 'go' }
    ]
  },
  {
    key: 'projects',
    label: t.groups.projects,
    items: c.projects.map((project) => ({
      id: `p-${slug(project.name)}`,
      label: project.name,
      meta: project.url ? t.cmd.repo : t.cmd.noRepo,
      keywords: `${project.allTags.join(' ')} ${project.oneLiner}`,
      icon: 'repo' as const,
      href: project.url || `#project-${slug(project.name)}`,
      action: 'go' as const,
      external: Boolean(project.url)
    }))
  },
  {
    key: 'experience',
    label: t.groups.experience,
    items: work.map((job, index) => ({
      id: `j-${index}`,
      label: `${job.role} · ${job.organisation}`,
      meta: job.period,
      keywords: `${job.tech.join(' ')} ${releaseOf(index)}`,
      icon: 'briefcase' as const,
      href: `#job-${index}`,
      action: 'job' as const,
      value: String(index)
    }))
  },
  {
    key: 'skills',
    label: t.groups.skills,
    items: c.skillGroups.map((group, index) => ({
      id: `s-${index}`,
      label: group.name,
      meta: `${group.keywords.length} · ${t.cmd.skill}`,
      keywords: group.keywords.map((skill) => skill.name).join(' '),
      icon: 'layers' as const,
      href: '#skills',
      action: 'skill' as const,
      value: String(index)
    }))
  },
  {
    key: 'certs',
    label: t.groups.certs,
    items: certificates.map((cert, index) => ({
      id: `c-${index}`,
      label: cert.name,
      meta: [cert.issuer, cert.date.slice(0, 4)].filter(Boolean).join(' · ') || t.cmd.certMeta,
      keywords: 'certification certificate',
      icon: 'badge' as const,
      href: cert.url || '#certifications',
      action: 'go' as const,
      external: Boolean(cert.url)
    }))
  }
];
---

<html lang={locale}>
  <head>
    <SeoHead
      title={seo.title}
      description={seo.description}
      canonical={seo.canonical}
      ogLocale={seo.ogLocale}
      ogLocaleAlternate={seo.ogLocaleAlternate}
      ogTitle={seo.ogTitle}
      ogDescription={seo.ogDescription}
      alternates={getAlternateLinks()}
      noindex
    />
    <link rel="preload" href="/assets/fonts/funnel-display-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/onest-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0a0b0d" />
    <script is:inline>
      document.documentElement.classList.add('cp-js');
    </script>
  </head>
  <body class="cp">
    <a class="cp-skip" href="#main">{t.skip}</a>

    <header class="cp-bar">
      <div class="cp-bar-inner">
        <a class="cp-brand" href={t.home} aria-label="David Barreiro">
          <span class="cp-brand-mark" aria-hidden="true">db</span>
          <span class="cp-brand-text">David Barreiro</span>
        </a>
        <button type="button" class="cp-trigger" data-open-palette aria-haspopup="dialog">
          <Icon name="search" />
          <span class="cp-trigger-text">{t.searchLong}</span>
          <span class="cp-sr">{t.search}</span>
          <kbd class="cp-kbd" data-shortcut>⌘K</kbd>
        </button>
        <nav class="cp-nav" aria-label={t.sections}>
          <a href="#portfolio">{t.nav.portfolio}</a>
          <a href="#experience">{t.nav.experience}</a>
          <a href="#skills">{t.nav.skills}</a>
        </nav>
        <div class="cp-bar-end">
          <ThemeSwitch locale={locale} current="command" />
          <div class="cp-lang" role="group" aria-label={t.langLabel}>
            <a href="/v9/" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
            <a href="/es/v9/" hreflang="es" aria-current={locale === 'es' ? 'page' : undefined}>ES</a>
          </div>
          <a class="cp-btn cp-btn-primary cp-btn-sm" href="#contact">{t.nav.contact}</a>
        </div>
      </div>
    </header>

    <main id="main">
      <!-- ============ HERO ============ -->
      <section class="cp-hero" aria-labelledby="cp-title">
        <div class="cp-hero-glow" aria-hidden="true"></div>
        <div class="cp-hero-copy">
          <div class="cp-who">
            <img src="/assets/profile/avatar-112.avif" alt="" width="52" height="52" />
            <p class="cp-hero-kicker">{basics.label}</p>
          </div>
          <h1 id="cp-title" class="cp-headline">
            <span>{c.name.split(' ')[0]}</span>
            <span class="cp-headline-accent">{c.name.split(' ').slice(1).join(' ')}</span>
          </h1>
          {summary[0] && <p class="cp-lede">{summary[0]}</p>}
          {
            summary.length > 1 && (
              <details class="cp-summary-more">
                <summary>
                  <span class="cp-more-closed">{t.readMore}</span>
                  <span class="cp-more-open">{t.readLess}</span>
                </summary>
                {summary.slice(1).map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </details>
            )
          }
          <div class="cp-actions">
            <a class="cp-btn cp-btn-primary" href={`mailto:${c.email}`}>
              <Icon name="mail" />{t.contact}
            </a>
            <details class="cp-cv" data-cv>
              <summary class="cp-btn">
                <Icon name="download" />{t.cv}
              </summary>
              <ul>
                {
                  c.cvOptions.map((option) => (
                    <li>
                      <a href={option.href} target="_blank" rel="noopener noreferrer">
                        <strong>{t.cvOptions[option.key][0]}</strong>
                        <span>{t.cvOptions[option.key][1]}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
          </div>
          <dl class="cp-stats">
            <div><dt>{t.metrics.experience}</dt><dd>{years}+</dd></div>
            <div><dt>{t.metrics.coreSkills}</dt><dd>{coreSkills}+</dd></div>
            <div class="cp-stats-focus"><dt>{t.metrics.focus}</dt><dd>{t.metrics.focusValue}</dd></div>
          </dl>
          <p class="cp-links">
            <a href={c.githubUrl} target="_blank" rel="noopener noreferrer">GitHub<Icon name="external" /></a>
            <a href={c.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn<Icon name="external" /></a>
          </p>
        </div>

        <div class="cp-hero-palette">
          <div class="cp-window">
            <div class="cp-window-bar" aria-hidden="true">
              <span class="cp-dots"><i></i><i></i><i></i></span>
              <span class="cp-window-title">davidbarreiro — search</span>
            </div>
            <Palette id="hero" variant="inline" groups={groups} labels={t.palette} />
          </div>
          <p class="cp-caption">{t.paletteCaption}</p>
        </div>
      </section>

      <!-- ============ CAPABILITIES ============ -->
      <section class="cp-section cp-caps-section" id="capabilities" aria-labelledby="capabilities-title" data-reveal>
        <h2 id="capabilities-title" class="cp-sr">{t.capabilitiesTitle}</h2>
        <ul class="cp-caps">
          {
            t.capabilities.map((card, index) => (
              <li class="cp-cap" style={`--i:${index}`}>
                <p class="cp-cap-label">
                  <span class="cp-cap-key" aria-hidden="true">{['be', 'da', 'pl'][index]}</span>
                  {card.label}
                </p>
                <h3>{card.heading}</h3>
                <p>{card.description}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- ============ PORTFOLIO: REPOSITORIES ============ -->
      <section class="cp-section" id="portfolio" aria-labelledby="portfolio-title" data-projects data-reveal>
        <header class="cp-head">
          <p class="cp-kicker"><span aria-hidden="true">01</span>{t.portfolioKicker}</p>
          <h2 id="portfolio-title">{t.portfolioTitle}</h2>
          <p>{t.projectsIntro}</p>
        </header>
        <div class="cp-filter" role="group" aria-label={t.filterLabel}>
          <button type="button" class="cp-chip-btn" data-tag="" aria-pressed="true">{t.filterAll}</button>
          {
            allTags.map((tag, index) => (
              <button
                type="button"
                class:list={['cp-chip-btn', { 'is-extra': index >= PRIMARY_TAGS }]}
                data-tag={tag}
                aria-pressed="false"
              >
                {tag}
              </button>
            ))
          }
          {
            allTags.length > PRIMARY_TAGS && (
              <button
                type="button"
                class="cp-more"
                aria-expanded="false"
                data-more
                data-label-more={t.moreTopics(allTags.length - PRIMARY_TAGS)}
                data-label-less={t.lessTopics}
              >
                {t.moreTopics(allTags.length - PRIMARY_TAGS)}
              </button>
            )
          }
        </div>
        <div class="cp-filter-status">
          <p class="cp-count-line" role="status" data-count>{t.showing(c.projects.length, c.projects.length)}</p>
          <button type="button" class="cp-link-btn" data-clear hidden>{t.clear}</button>
        </div>
        <ul class="cp-repos">
          {
            c.projects.map((project) => (
              <li id={`project-${slug(project.name)}`} data-tags={JSON.stringify(project.allTags)}>
                <article class="cp-repo">
                  <header>
                    <span class="cp-repo-icon"><Icon name="repo" /></span>
                    <h3>
                      {project.url ? (
                        <a href={project.url} target="_blank" rel="noopener noreferrer">
                          {project.name}
                        </a>
                      ) : (
                        project.name
                      )}
                    </h3>
                    {project.url && <span class="cp-tag">{t.publicRepo}</span>}
                  </header>
                  <p>{project.oneLiner}</p>
                  <ul class="cp-topics" aria-label={t.filterLabel}>
                    {project.allTags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                  <footer>
                    {project.url ? (
                      <span class="cp-repo-go" aria-hidden="true">
                        {t.openRepo}
                        <Icon name="arrow" />
                      </span>
                    ) : (
                      <span class="cp-repo-none">{t.noRepo}</span>
                    )}
                  </footer>
                </article>
              </li>
            ))
          }
        </ul>
        <p class="cp-empty-state" hidden data-empty>{t.empty}</p>
      </section>

      <!-- ============ SYSTEM DESIGN: PIPELINE ============ -->
      <section class="cp-section" id="system-design" aria-labelledby="system-design-title" data-reveal>
        <header class="cp-head">
          <p class="cp-kicker"><span aria-hidden="true">02</span>{t.systemKicker}</p>
          <h2 id="system-design-title">{t.systemTitle}</h2>
          <p>{t.methodIntro}</p>
        </header>
        <div class="cp-run" data-run>
          <div class="cp-run-bar">
            <span class="cp-run-name"><span class="cp-check" aria-hidden="true"></span>{t.run} · data-platform</span>
            <span class="cp-run-meta" aria-hidden="true">{c.stages.length}/{c.stages.length}</span>
          </div>
          <div class="cp-graph" role="tablist" aria-label={t.systemTitle} aria-orientation="horizontal" data-graph>
            {
              c.stages.map((stage, index) => (
                <button
                  type="button"
                  class="cp-node"
                  role="tab"
                  id={`stage-tab-${index}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  aria-controls="stage-panel"
                  tabindex={index === 0 ? 0 : -1}
                  style={`--i:${index}`}
                  data-stage={index}
                >
                  <span class="cp-node-top">
                    <span class="cp-node-status" aria-hidden="true"></span>
                    <span class="cp-node-index">{pad(index + 1)}</span>
                  </span>
                  <span class="cp-node-name">{stage.name}</span>
                  <span class="cp-node-tech">{stage.tech.slice(0, 2).join(' · ')}</span>
                </button>
              ))
            }
          </div>
          <div class="cp-inspector" role="tabpanel" id="stage-panel" aria-labelledby="stage-tab-0" tabindex="0" data-inspector>
            <div class="cp-inspector-head">
              <span class="cp-inspector-label">{t.inspector}</span>
              <span class="cp-inspector-step" data-inspector-step>{t.stage(1, c.stages.length)}</span>
            </div>
            <h3 data-inspector-name>{c.stages[0].name}</h3>
            <p data-inspector-detail>{c.stages[0].detail}</p>
            <div class="cp-inspector-grid">
              <div>
                <p class="cp-field">{t.tech}</p>
                <ul class="cp-chips" data-inspector-tech>
                  {c.stages[0].tech.map((tech) => <li>{tech}</li>)}
                </ul>
              </div>
              <div class="cp-io">
                <p><span class="cp-field">{t.input}</span><span data-inspector-in>{t.source}</span></p>
                <p><span class="cp-field">{t.output}</span><span data-inspector-out>{c.stages[1]?.name ?? t.sink}</span></p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ EXPERIENCE: RELEASES ============ -->
      <section class="cp-section" id="experience" aria-labelledby="experience-title" data-reveal>
        <header class="cp-head">
          <p class="cp-kicker"><span aria-hidden="true">03</span>{t.timelineKicker}</p>
          <h2 id="experience-title">{t.timelineTitle}</h2>
          <p>{t.workIntro}</p>
        </header>
        <ol class="cp-log">
          {
            work.map((job, index) => (
              <li class="cp-release" id={`job-${index}`}>
                <details open={index === 0} data-release>
                  <summary>
                    <span class="cp-release-ver">{releaseOf(index)}</span>
                    <span class="cp-release-main">
                      <span class="cp-release-role">{job.role}</span>
                      <span class="cp-release-org">{job.organisation}</span>
                    </span>
                    <span class="cp-release-side">
                      {index === 0 && <span class="cp-tag cp-tag-live">{t.latest}</span>}
                      <time>{job.period}</time>
                      <span class="cp-release-toggle" aria-hidden="true"></span>
                    </span>
                  </summary>
                  <div class="cp-release-body">
                    {job.summary && <p class="cp-release-summary">{job.summary}</p>}
                    {job.highlights.length > 0 && (
                      <>
                        <p class="cp-field">{t.changes}</p>
                        <ul class="cp-diff">
                          {job.highlights.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </>
                    )}
                    {job.tech.length > 0 && (
                      <>
                        <p class="cp-field">{t.stack}</p>
                        <ul class="cp-chips">
                          {job.tech.map((tech) => (
                            <li>{tech}</li>
                          ))}
                        </ul>
                      </>
                    )}
                  </div>
                </details>
              </li>
            ))
          }
        </ol>
        <div class="cp-edu">
          <h3><Icon name="cap" />{t.educationTitle}</h3>
          <ul>
            {
              education.map((item) => (
                <li>
                  <time>{item.period}</time>
                  <span class="cp-edu-role">{item.role}</span>
                  <span class="cp-edu-org">{item.organisation}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ============ SKILLS: SETTINGS ============ -->
      <section class="cp-section" id="skills" aria-labelledby="skills-title" data-reveal>
        <header class="cp-head">
          <p class="cp-kicker"><span aria-hidden="true">04</span>{t.skillsKicker}</p>
          <h2 id="skills-title">{t.skillsTitle}</h2>
          <p>{t.skillsIntro}</p>
        </header>
        <div class="cp-settings">
          <div class="cp-tabs" role="tablist" aria-label={t.skillsKicker} aria-orientation="vertical" data-tabs>
            {
              c.skillGroups.map((group, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`skill-tab-${index}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  aria-controls={`skill-panel-${index}`}
                  tabindex={index === 0 ? 0 : -1}
                  data-skill-tab={index}
                >
                  <span>{group.name}</span>
                  <span class="cp-tab-count">{group.keywords.length}</span>
                </button>
              ))
            }
          </div>
          {
            c.skillGroups.map((group, index) => (
              <div
                class="cp-panel"
                role="tabpanel"
                id={`skill-panel-${index}`}
                aria-labelledby={`skill-tab-${index}`}
                tabindex="0"
                hidden={index !== 0}
              >
                <div class="cp-panel-head">
                  <h3>{group.name}</h3>
                  {group.level && (
                    <p>
                      {t.groupLevel}: <strong>{group.level}</strong>
                    </p>
                  )}
                </div>
                <ul class="cp-skill-rows">
                  {group.keywords.map((skill) => {
                    const value = levelValue(skill.level);
                    return (
                      <li>
                        <span class="cp-skill-logo">
                          {skill.logo ? <img src={skill.logo} alt="" width="20" height="20" loading="lazy" /> : <span />}
                        </span>
                        <span class="cp-skill-name">
                          {skill.name}
                          {skill.certifications.map((cert) =>
                            cert.url ? (
                              <a class="cp-tag cp-tag-cert" href={cert.url} target="_blank" rel="noopener noreferrer">
                                {t.certified} · {cert.issuer}
                              </a>
                            ) : (
                              <span class="cp-tag cp-tag-cert">
                                {t.certified} · {cert.issuer}
                              </span>
                            )
                          )}
                        </span>
                        {value > 0 && (
                          <span class="cp-meter" data-level={value}>
                            <span class="cp-meter-bars" aria-hidden="true">
                              <i />
                              <i />
                              <i />
                            </span>
                            <span class="cp-meter-label">{t.levelNames[value]}</span>
                          </span>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </div>

        <div class="cp-certs" id="certifications">
          <h3><Icon name="badge" />{t.certsTitle}</h3>
          <ol>
            {
              certificates.map((cert) => (
                <li>
                  <time>{cert.date.slice(0, 7)}</time>
                  <span class="cp-cert-name">{cert.name}</span>
                  <span class="cp-cert-issuer">{cert.issuer}</span>
                  {cert.url ? (
                    <a href={cert.url} target="_blank" rel="noopener noreferrer">
                      {t.verify}
                      <Icon name="external" />
                    </a>
                  ) : (
                    <span />
                  )}
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- ============ CONTACT ============ -->
      <section class="cp-section cp-contact" id="contact" aria-labelledby="contact-title" data-reveal>
        <div class="cp-contact-card">
          <p class="cp-kicker"><span aria-hidden="true">05</span>{t.contactKicker}</p>
          <h2 id="contact-title">{t.contactTitle}</h2>
          <p>{t.contactText}</p>
          <div class="cp-mailbox">
            <code>{c.email}</code>
            <button type="button" class="cp-btn cp-btn-sm" data-copy={c.email}>
              <Icon name="copy" />{t.copy}
            </button>
            <a class="cp-btn cp-btn-primary cp-btn-sm" href={`mailto:${c.email}`}>
              <Icon name="mail" />{t.send}
            </a>
          </div>
          <p class="cp-links">
            <a href={c.githubUrl} target="_blank" rel="noopener noreferrer">GitHub<Icon name="external" /></a>
            <a href={c.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn<Icon name="external" /></a>
            <a href={t.other.href} hreflang={locale === 'en' ? 'es' : 'en'}>{t.other.label}</a>
          </p>
        </div>
      </section>
    </main>

    <footer class="cp-footer">
      <p>© {nowYear} {c.name} · {t.footerRole}</p>
      <p class="cp-footer-hint">
        {t.footerHint} <kbd class="cp-kbd" data-shortcut>⌘K</kbd>
        {t.footerHint2}
      </p>
    </footer>

    <dialog class="cp-dialog" aria-label={t.palette.input} data-dialog>
      <Palette id="modal" variant="modal" groups={groups} labels={t.palette} />
    </dialog>

    <p class="cp-toast" role="status" aria-live="polite" data-toast></p>

    <script
      is:inline
      type="application/json"
      id="cp-data"
      set:html={JSON.stringify({
        stages: c.stages,
        labels: {
          stage: t.stage(0, 0).replace(/\d+/g, '{n}'),
          showing: t.showing(0, 0).replace(/\d+/g, '{n}'),
          results: t.palette.results,
          source: t.source,
          sink: t.sink,
          copied: t.copied,
          copyFailed: t.copyFailed
        },
        demo: ['kafka', 'go', 'cv']
      })}
    />
    <script>
      import './command.ts';
    </script>
  </body>
</html>
