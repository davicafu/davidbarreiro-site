      { id: 'mail', label: t.cmd.mail, meta: c.email, keywords: 'email mail contact', icon: 'mail', href: `mailto:${c.email}`, action: 'go' },
      { id: 'lang', label: t.cmd.lang, meta: t.other.code, keywords: 'language idioma english inglés spanish español', icon: 'globe', href: t.other.href, action: 'go' },
      { id: 'github', label: 'GitHub', meta: c.githubUrl.replace(/^https?:\/\//, ''), keywords: 'code repos', icon: 'github', href: c.githubUrl, action: 'go', external: true },
      { id: 'linkedin', label: 'LinkedIn', meta: c.linkedinUrl.replace(/^https?:\/\/(www\.)?/, ''), keywords: 'profile', icon: 'linkedin', href: c.linkedinUrl, action: 'go', external: true },
      { id: 'help', label: t.help.title, meta: '?', keywords: 'help ayuda ? commands comandos shortcuts atajos keys teclas', icon: 'help', href: '#cp-help', action: 'help' }
    ]
  },
