---

<html lang={locale}>
  <head>
    <SeoHead
      title={seo.title}
      description={seo.description}
      canonical={seo.canonical}
      ogLocale={seo.ogLocale}
      ogLocaleAlternate={seo.ogLocaleAlternate}
      ogTitle={seo.ogTitle}
      ogDescription={seo.ogDescription}
      alternates={getAlternateLinks()}
    />
    <link rel="preload" href="/assets/fonts/ibm-plex-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/ibm-plex-mono-500-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0a0d0b" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var nav = navigator;
        var platform = (nav.userAgentData && nav.userAgentData.platform) || nav.platform || nav.userAgent || '';
        root.classList.add('cp-js');
        // Shortcut labels read ⌘K on Apple devices and Ctrl K elsewhere, set before first paint.
        root.dataset.os = /mac|iphone|ipad|ipod|ios/i.test(platform) ? 'mac' : 'other';
      })();
    </script>
  </head>
  <body class="cp">
    <a class="cp-skip" href="#main">{t.skip}</a>

    <header class="cp-bar">
      <div class="cp-bar-inner">
        <a class="cp-brand" href={t.home} aria-label="David Barreiro">
          <img class="cp-brand-mark" src="/assets/brand/db-mark-dev.svg" alt="" width="40" height="24" />
          <span class="cp-brand-text">David Barreiro</span>
        </a>
        <button type="button" class="cp-trigger" data-open-palette aria-haspopup="dialog">
          <Icon name="search" />
          <span class="cp-trigger-text">{t.searchLong}</span>
          <span class="cp-sr">{t.search}</span>
          <kbd class="cp-kbd" data-shortcut><span data-os="mac">⌘K</span><span data-os="other">Ctrl K</span></kbd>
        </button>
        <nav class="cp-nav" aria-label={t.sections}>
          <a href="#portfolio">{t.nav.portfolio}</a>
          <a href="#experience">{t.nav.experience}</a>
          <a href="#skills">{t.nav.skills}</a>
        </nav>
        <div class="cp-bar-end">
          <ThemeSwitch locale={locale} current="command" />
          <div class="cp-lang" role="group" aria-label={t.langLabel}>
            <a href="/" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
            <a href="/es/" hreflang="es" aria-current={locale === 'es' ? 'page' : undefined}>ES</a>
          </div>
          <a class="cp-btn cp-btn-primary cp-btn-sm" href="#contact">{t.nav.contact}</a>
        </div>
      </div>
    </header>

    <main id="main">
      <!-- ============ HERO: developer tool landing (whoami readout + palette) ============ -->
      <section class="cp-hero" aria-labelledby="cp-title">
        <div class="cp-hero-glow" aria-hidden="true"></div>
        <div class="cp-hero-copy">
          <div class="cp-who">
            <img src="/assets/profile/avatar-112.avif" alt="" width="52" height="52" />
            <p class="cp-hero-kicker">{basics.label}</p>
          </div>
          <h1 id="cp-title" class="cp-headline">
            <span>{c.name.split(' ')[0]}</span>
            <span class="cp-headline-accent">{c.name.split(' ').slice(1).join(' ')}</span>
          </h1>
          <p class="cp-lede">{c.copy.summary}</p>
          {
            summary.length > 0 && (
              <details class="cp-summary-more">
                <summary>
                  <span class="cp-more-closed">{t.readMore}</span>
                  <span class="cp-more-open">{t.readLess}</span>
                </summary>
                {summary.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </details>
            )
          }
          <div class="cp-actions">
            <button type="button" class="cp-btn cp-btn-primary cp-btn-search" data-open-palette aria-haspopup="dialog">
              <Icon name="search" />{t.searchAll}
              <kbd class="cp-kbd" data-shortcut><span data-os="mac">⌘K</span><span data-os="other">Ctrl K</span></kbd>
            </button>
            <a class="cp-btn" href={`mailto:${c.email}`}>
              <Icon name="mail" />{t.contact}
            </a>
            <a class="cp-btn" href={c.cvUrl} target="_blank" rel="noopener noreferrer">
              <Icon name="download" />{t.cv}
            </a>
          </div>
          <p class="cp-links">
            <a href={c.githubUrl} target="_blank" rel="noopener noreferrer"><Icon name="github" class="cp-brand-glyph" />GitHub<Icon name="external" /></a>
            <a href={c.linkedinUrl} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" class="cp-brand-glyph" />LinkedIn<Icon name="external" /></a>
          </p>
        </div>

        <div class="cp-hero-palette">
          <div class="cp-window">
            <div class="cp-window-bar" aria-hidden="true">
              <span class="cp-dots"><i></i><i></i><i></i></span>
              <span class="cp-window-title">davidbarreiro — dev</span>
            </div>
            <div class="cp-readout">
              <p class="cp-readout-cmd" aria-hidden="true"><span>$</span> whoami --verbose</p>
              <dl aria-label={t.readout.title}>
                {
                  currentJob && (
                    <div>
                      <dt>now</dt>
                      <dd>
                        {currentJob.role.toLowerCase()} <span class="cp-readout-dim">{t.readout.at}</span>{' '}
                        <span class="cp-readout-hl">{currentJob.organisation.toLowerCase()}</span>
                      </dd>
                    </div>
                  )
                }
                {
                  readoutStack.length > 0 && (
                    <div>
                      <dt>stack</dt>
                      <dd>{readoutStack.join(' → ')}</dd>
                    </div>
                  )
                }
                {
                  readoutCerts.length > 0 && (
                    <div>
                      <dt>certs</dt>
                      <dd class="cp-readout-list">
                        {readoutCerts.map((cert, index) => (
                          <>
                            {index > 0 && <span class="cp-readout-dim">,</span>}
                            <a
                              href={cert.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              aria-label={`${cert.name} · ${t.readout.credential}`}
                              title={cert.name}
                            >
                              {cert.short}
                              <Icon name="external" />
                            </a>
                          </>
                        ))}
                      </dd>
                    </div>
                  )
                }
                <div>
                  <dt>projects</dt>
                  <dd>
                    <a href="#portfolio">{t.readout.projects(c.projects.length)} <span aria-hidden="true">→</span></a>
                  </dd>
                </div>
              </dl>
            </div>
            <Palette id="hero" variant="inline" groups={groups} labels={t.palette} />
          </div>
          <p class="cp-caption">{t.paletteCaption}</p>
        </div>
      </section>

      <!-- ============ CAPABILITIES ============ -->
      <section class="cp-section cp-caps-section" id="capabilities" aria-labelledby="capabilities-title" data-reveal>
        <h2 id="capabilities-title" class="cp-sr">{t.capabilitiesTitle}</h2>
        <ul class="cp-caps">
          {
            c.capabilities.map((card, index) => (
              <li class="cp-cap" style={`--i:${index}`}>
                <p class="cp-cap-label">
                  <span class="cp-cap-key" aria-hidden="true">{['be', 'da', 'pl'][index]}</span>
                  {card.label}
                </p>
                <h3>{card.heading}</h3>
                <ul class="cp-cap-proof">
                  {card.proof.map((item) => (
                    <li>
                      {item.text}
                      <span>{item.where}</span>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- ============ PORTFOLIO: REPOSITORIES ============ -->
      <section class="cp-section" id="portfolio" aria-labelledby="portfolio-title" data-projects data-reveal>
        <header class="cp-head">
          <p class="cp-kicker"><span aria-hidden="true">01</span>{t.portfolioKicker}</p>
          <p class="cp-prompt" aria-hidden="true" style={`--n:${prompts.portfolio.length}`}><span class="cp-prompt-who">david@dev</span><span class="cp-prompt-path">:~$</span> <span class="cp-prompt-cmd">{prompts.portfolio}</span></p>
          <h2 id="portfolio-title">{t.portfolioTitle}</h2>
          <p>{t.projectsIntro}</p>
        </header>
        <div class="cp-filter" role="group" aria-label={t.filterLabel}>
          <button type="button" class="cp-chip-btn" data-tag="" aria-pressed="true">{t.filterAll}</button>
          {
            allTags.map((tag, index) => (
              <button
                type="button"
                class:list={['cp-chip-btn', { 'is-extra': index >= PRIMARY_TAGS }]}
                data-tag={tag}
                aria-pressed="false"
              >
                {tag}
              </button>
            ))
          }
          {
            allTags.length > PRIMARY_TAGS && (
              <button
                type="button"
                class="cp-more"
                aria-expanded="false"
                data-more
                data-label-more={t.moreTopics(allTags.length - PRIMARY_TAGS)}
                data-label-less={t.lessTopics}
              >
                {t.moreTopics(allTags.length - PRIMARY_TAGS)}
              </button>
            )
          }
        </div>
        <div class="cp-filter-status">
          <p class="cp-count-line" role="status" data-count>{t.showing(c.projects.length, c.projects.length)}</p>
          <button type="button" class="cp-link-btn" data-clear hidden>{t.clear}</button>
        </div>
        <ul class="cp-repos">
          {
            c.projects.map((project) => (
              <li id={`project-${slug(project.name)}`} data-tags={JSON.stringify(project.allTags)}>
                <article class="cp-repo">
                  <header>
                    <span class="cp-repo-icon"><Icon name={projectIcon(project.name)} /></span>
                    <h3>
                      {project.url ? (
                        <a href={project.url} target="_blank" rel="noopener noreferrer">
                          {project.name}
                        </a>
                      ) : (
                        project.name
                      )}
                    </h3>
                    {project.url && <span class="cp-tag">{t.publicRepo}</span>}
                  </header>
                  <p>{project.oneLiner}</p>
                  <ul class="cp-topics" aria-label={t.filterLabel}>
                    {project.allTags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                  <footer>
                    {project.url ? (
                      <span class="cp-repo-go" aria-hidden="true">
                        {t.openRepo}
                        <Icon name="arrow" />
                      </span>
                    ) : (
                      <span class="cp-repo-none">{t.noRepo}</span>
                    )}
                  </footer>
                </article>
              </li>
            ))
          }
        </ul>
        <p class="cp-empty-state" hidden data-empty>{t.empty}</p>
      </section>

      <!-- ============ SYSTEM DESIGN: PIPELINE ============ -->
      <section class="cp-section" id="system-design" aria-labelledby="system-design-title" data-reveal>
        <header class="cp-head">
          <p class="cp-kicker"><span aria-hidden="true">02</span>{t.systemKicker}</p>
          <p class="cp-prompt" aria-hidden="true" style={`--n:${prompts.system.length}`}><span class="cp-prompt-who">david@dev</span><span class="cp-prompt-path">:~$</span> <span class="cp-prompt-cmd">{prompts.system}</span></p>
          <h2 id="system-design-title">{t.systemTitle}</h2>
          <p>{t.methodIntro}</p>
        </header>
        <div class="cp-run is-done" data-run>
          <div class="cp-run-bar">
            <span class="cp-run-name"><span class="cp-run-dot" aria-hidden="true"></span>{t.run} · data-platform</span>
            <span class="cp-run-status" role="status" data-run-status>{t.runStatus.done}</span>
            <span class="cp-run-meta" aria-hidden="true">
              <span data-run-count>{c.stages.length}/{c.stages.length}</span>
              <span data-run-time>{totalSeconds}s</span>
            </span>
            <button type="button" class="cp-run-again" data-rerun hidden>
              <Icon name="rerun" />{t.rerun}
            </button>
          </div>
          <div class="cp-run-body">
            <div class="cp-graph" role="tablist" aria-label={t.systemTitle} aria-orientation="vertical" data-graph>
              {
                c.stages.map((stage, index) => (
                  <button
                    type="button"
                    class="cp-node"
                    role="tab"
                    id={`stage-tab-${index}`}
                    aria-selected={index === 0 ? 'true' : 'false'}
                    aria-controls="stage-panel"
                    tabindex={index === 0 ? 0 : -1}
                    style={`--i:${index};--ms:${stageMs[index]}ms`}
                    data-stage={index}
                    data-state="done"
                  >
                    <span class="cp-node-status" aria-hidden="true"></span>
                    <span class="cp-node-index" aria-hidden="true">{pad(index + 1)}</span>
                    <span class="cp-node-name">{stage.name}</span>
                    <span class="cp-node-time" aria-hidden="true" data-node-time>{(stageMs[index] / 1000).toFixed(1)}s</span>
                    <span class="cp-node-tech">{stage.tech.slice(0, 3).join(' · ')}</span>
                    <span class="cp-sr" data-node-state>{t.runState.done}</span>
                    <span class="cp-node-bar" aria-hidden="true"></span>
                  </button>
                ))
              }
            </div>
            <div class="cp-run-main">
              <div class="cp-inspector" role="tabpanel" id="stage-panel" aria-labelledby="stage-tab-0" tabindex="0" data-inspector>
                <div class="cp-inspector-head">
                  <span class="cp-inspector-label">{t.inspector}</span>
                  <span class="cp-inspector-step" data-inspector-step>{t.stage(1, c.stages.length)}</span>
                </div>
                <h3 data-inspector-name>{c.stages[0].name}</h3>
                <p data-inspector-detail>{c.stages[0].detail}</p>
                <div class="cp-inspector-grid">
                  <div>
                    <p class="cp-field">{t.tech}</p>
                    <ul class="cp-chips" data-inspector-tech>
                      {c.stages[0].tech.map((tech) => <li>{tech}</li>)}
                    </ul>
                  </div>
                  <div class="cp-io">
                    <p><span class="cp-field">{t.input}</span><span data-inspector-in>{t.source}</span></p>
                    <p><span class="cp-field">{t.output}</span><span data-inspector-out>{c.stages[1]?.name ?? t.sink}</span></p>
                  </div>
                </div>
              </div>
              <div class="cp-console" aria-hidden="true">
                <p class="cp-console-title">{t.console}</p>
                <ol class="cp-console-lines" data-console>
                  {stageLog.flat().map((line) => <li class={`is-${line.kind}`}>{line.text}</li>)}
                </ol>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ EXPERIENCE: RELEASES ============ -->
      <section class="cp-section" id="experience" aria-labelledby="experience-title" data-reveal>
        <header class="cp-head">
          <p class="cp-kicker"><span aria-hidden="true">03</span>{t.timelineKicker}</p>
          <p class="cp-prompt" aria-hidden="true" style={`--n:${prompts.experience.length}`}><span class="cp-prompt-who">david@dev</span><span class="cp-prompt-path">:~$</span> <span class="cp-prompt-cmd">{prompts.experience}</span></p>
          <h2 id="experience-title">{t.timelineTitle}</h2>
          <p>{t.workIntro}</p>
        </header>
        <ol class="cp-log">
          {
            work.map((job, index) => (
              <li class="cp-release" id={`job-${index}`}>
                <details open={index === 0} data-release>
                  <summary>
                    <span class="cp-release-ver">{releaseOf(index)}</span>
                    <span class="cp-release-main">
                      <span class="cp-release-role">{job.role}</span>
                      <span class="cp-release-org">{job.organisation}</span>
                    </span>
                    <span class="cp-release-side">
                      {index === 0 && <span class="cp-tag cp-tag-live">{t.latest}</span>}
                      <time>{job.period}</time>
                      <span class="cp-release-toggle" aria-hidden="true"></span>
                    </span>
                  </summary>
                  <div class="cp-release-body">
                    {job.summary && <p class="cp-release-summary">{job.summary}</p>}
                    {job.highlights.length > 0 && (
                      <>
                        <p class="cp-field">{t.changes}</p>
                        <ul class="cp-diff">
                          {job.highlights.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </>
                    )}
                    {job.tech.length > 0 && (
                      <>
                        <p class="cp-field">{t.stack}</p>
                        <ul class="cp-chips">
                          {job.tech.map((tech) => (
                            <li>{tech}</li>
                          ))}
                        </ul>
                      </>
                    )}
                  </div>
                </details>
              </li>
            ))
          }
        </ol>
        <div class="cp-edu">
          <h3><Icon name="cap" />{t.educationTitle}</h3>
          <ul>
            {
              education.map((item) => (
                <li>
                  <time>{item.period}</time>
                  <span class="cp-edu-role">{item.role}</span>
                  <span class="cp-edu-org">{item.organisation}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ============ SKILLS: SETTINGS ============ -->
      <section class="cp-section" id="skills" aria-labelledby="skills-title" data-reveal>
        <header class="cp-head">
          <p class="cp-kicker"><span aria-hidden="true">04</span>{t.skillsKicker}</p>
          <p class="cp-prompt" aria-hidden="true" style={`--n:${prompts.skills.length}`}><span class="cp-prompt-who">david@dev</span><span class="cp-prompt-path">:~$</span> <span class="cp-prompt-cmd">{prompts.skills}</span></p>
          <h2 id="skills-title">{t.skillsTitle}</h2>
          <p>{t.skillsIntro}</p>
        </header>
        <div class="cp-settings">
          <div class="cp-tabs" role="tablist" aria-label={t.skillsKicker} aria-orientation="vertical" data-tabs>
            {
              c.skillGroups.map((group, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`skill-tab-${index}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  aria-controls={`skill-panel-${index}`}
                  tabindex={index === 0 ? 0 : -1}
                  data-skill-tab={index}
                >
                  <span>{group.name}</span>
                  <span class="cp-tab-count">{group.keywords.length}</span>
                </button>
              ))
            }
          </div>
          {
            c.skillGroups.map((group, index) => (
              <div
                class="cp-panel"
                role="tabpanel"
                id={`skill-panel-${index}`}
                aria-labelledby={`skill-tab-${index}`}
                tabindex="0"
                hidden={index !== 0}
              >
                <div class="cp-panel-head">
                  <h3>{group.name}</h3>
                  {group.level && (
                    <p>
                      {t.groupLevel}: <strong>{group.level}</strong>
                    </p>
                  )}
                </div>
                <ul class="cp-skill-rows">
                  {group.keywords.map((skill) => {
                    const value = levelValue(skill.level);
                    return (
                      <li>
                        <span class="cp-skill-logo">
                          {skill.logo ? <img src={skill.logo} alt="" width="20" height="20" loading="lazy" /> : <span />}
                        </span>
                        <span class="cp-skill-name">
                          {skill.name}
                          {skill.certifications.map((cert) =>
                            cert.url ? (
                              <a class="cp-tag cp-tag-cert" href={cert.url} target="_blank" rel="noopener noreferrer">
                                {t.certified} · {cert.issuer}
                              </a>
                            ) : (
                              <span class="cp-tag cp-tag-cert">
                                {t.certified} · {cert.issuer}
                              </span>
                            )
                          )}
                        </span>
                        {value > 0 && (
                          <span class="cp-meter" data-level={value}>
                            <span class="cp-meter-bars" aria-hidden="true">
                              <i />
                              <i />
                              <i />
                            </span>
                            <span class="cp-meter-label">{t.levelNames[value]}</span>
                          </span>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </div>

        <div class="cp-certs" id="certifications">
          <h3><Icon name="badge" />{t.certsTitle}</h3>
          <ol>
            {
              certificates.map((cert) => (
                <li>
                  <time>{cert.date.slice(0, 7)}</time>
                  <span class="cp-cert-name">{cert.name}</span>
                  <span class="cp-cert-issuer">{cert.issuer}</span>
                  {cert.url ? (
                    <a href={cert.url} target="_blank" rel="noopener noreferrer">
                      {t.verify}
                      <Icon name="external" />
                    </a>
                  ) : (
                    <span />
                  )}
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- ============ CONTACT ============ -->
      <section class="cp-section cp-contact" id="contact" aria-labelledby="contact-title" data-reveal>
        <div class="cp-contact-card">
          <p class="cp-kicker"><span aria-hidden="true">05</span>{t.contactKicker}</p>
          <p class="cp-prompt" aria-hidden="true" style={`--n:${prompts.contact.length}`}><span class="cp-prompt-who">david@dev</span><span class="cp-prompt-path">:~$</span> <span class="cp-prompt-cmd">{prompts.contact}</span></p>
          <h2 id="contact-title">{t.contactTitle}</h2>
          <p>{t.contactText}</p>
          <div class="cp-mailbox">
            <code>{c.email}</code>
            <button type="button" class="cp-btn cp-btn-sm" data-copy={c.email}>
              <Icon name="copy" />{t.copy}
            </button>
            <a class="cp-btn cp-btn-primary cp-btn-sm" href={`mailto:${c.email}`}>
              <Icon name="mail" />{t.send}
            </a>
          </div>
          <p class="cp-links">
            <a href={c.githubUrl} target="_blank" rel="noopener noreferrer"><Icon name="github" class="cp-brand-glyph" />GitHub<Icon name="external" /></a>
            <a href={c.linkedinUrl} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" class="cp-brand-glyph" />LinkedIn<Icon name="external" /></a>
            <a href={t.other.href} hreflang={locale === 'en' ? 'es' : 'en'}>{t.other.label}</a>
          </p>
        </div>
      </section>
    </main>

    <div class="cp-statusbar" aria-hidden="true">
      <span class="cp-sb-mode">DEV</span>
      <span class="cp-sb-item">⎇ main</span>
      <span class="cp-sb-item cp-sb-path" data-sb-path>~</span>
      <span class="cp-sb-fill"></span>
      <span class="cp-sb-item">utf-8</span>
      <span class="cp-sb-item">{locale}</span>
      <span class="cp-sb-item cp-sb-keys"><span data-os="mac">⌘K</span><span data-os="other">Ctrl K</span> · ?</span>
      <span class="cp-sb-item cp-sb-pos" data-sb-pos>Top</span>
    </div>

    <footer class="cp-footer">
      <p>© {nowYear} {c.name} · {t.footerRole}</p>
      <p class="cp-footer-hint">
        {t.footerHint} <kbd class="cp-kbd" data-shortcut><span data-os="mac">⌘K</span><span data-os="other">Ctrl K</span></kbd>
        {t.footerHint2}
      </p>
    </footer>

    <dialog class="cp-dialog" aria-label={t.palette.input} data-dialog>
      <Palette id="modal" variant="modal" groups={groups} labels={t.palette} />
    </dialog>

    <Help groups={groups} labels={t.help} />

    <p class="cp-toast" role="status" aria-live="polite" data-toast></p>

    <script
      is:inline
      type="application/json"
      id="cp-data"
      set:html={JSON.stringify({
        stages: c.stages,
        run: {
          ms: stageMs,
          log: stageLog,
          state: t.runState,
          status: t.runStatus
        },
        labels: {
          stage: t.stage(0, 0).replace(/\d+/g, '{n}'),
          showing: t.showing(0, 0).replace(/\d+/g, '{n}'),
          results: t.palette.results,
          source: t.source,
          sink: t.sink,
          copied: t.copied,
          copyFailed: t.copyFailed
        },
        demo: ['kafka', 'go', 'cv']
      })}
    />
    <script>
      import './command.ts';
    </script>
  </body>
</html>
