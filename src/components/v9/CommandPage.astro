const nowYear = new Date().getFullYear();
const certificates = [...c.certificateDetails].sort((a, b) => b.date.localeCompare(a.date));
const work = [...c.work].sort((a, b) => b.start - a.start);
const education = [...c.education].sort((a, b) => b.start - a.start);
const pad = (n: number) => String(n).padStart(2, '0');
const prefix = locale === 'es' ? '/es' : '';

/* ---- Hero: main-site kicker and name, condensed summary, full summary on demand ---- */
const basics = getResume(locale).basics;
const summary = String(basics.summary || '')
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);

/* ---- Hero readout: every value derived from the resume ---- */
const currentJob = c.work[0];
const readoutStack = c.nowPipeline;
// Only certifications with a public credential; short name is the issuer (or the name).
const readoutCerts = c.certificateDetails
  .filter((cert) => cert.url)
  .map((cert) => ({ ...cert, short: (cert.issuer || cert.name).toLowerCase() }));

// resume.json mixes case and has a typo ("Intemediate"); read levels by prefix.
const levelValue = (level: string) => {
  const value = level.trim().toLowerCase();
  if (value.startsWith('exp')) return 3;
  if (value.startsWith('adv') || value.startsWith('avan')) return 2;
  if (value.startsWith('int')) return 1;
  return 0;
};

/* ---- Project topics: the most frequent first ---- */
const PRIMARY_TAGS = 10;
const tagCounts = new Map<string, number>();
c.projects.forEach((project) =>
  project.allTags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1))
);
const allTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag]) => tag);

const slug = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

/* ---- Project icons: matched by subject on the project name (EN and ES names) ---- */
const projectIcon = (name: string): IconName => {
  const value = slug(name);
  if (/auth/.test(value)) return 'shieldKey';
  if (/worker|runtime/.test(value)) return 'workers';
  if (/microservic|grpc/.test(value)) return 'services';
  if (/event|analytic|analitic/.test(value)) return 'eventChart';
  if (/observ|trac|telemetr/.test(value)) return 'radar';
  if (/game|juego/.test(value)) return 'gamepad';
  if (/cli|terminal|shell/.test(value)) return 'terminal';
  return 'repo';
};

/* ---- Section prompts: the shell command each section "runs" (decorative) ---- */
const prompts = {
  portfolio: 'ls ~/projects',
  system: 'make pipeline',
  experience: 'git log --tags',
  skills: 'cat stack.toml',
  contact: './say --hello'
};

/* ---- System design run: per-stage duration and log lines, also rendered as the no-JS state ---- */
const stageMs = c.stages.map((_, index) => 650 + ((index * 3) % 5) * 140);
const stageLog = c.stages.map((stage, index) => [
  { kind: 'head', text: `▶ [${pad(index + 1)}/${pad(c.stages.length)}] ${stage.name}` },
  { kind: 'cmd', text: `$ run ${slug(stage.name)} --with ${stage.tech.map((tech) => slug(tech)).join(',')}` },
  {
    kind: 'io',
    text: `  ${t.input.toLowerCase()}: ${c.stages[index - 1]?.name ?? t.source} → ${t.output.toLowerCase()}: ${c.stages[index + 1]?.name ?? t.sink}`
  },
  { kind: 'ok', text: `✓ ${t.runState.done} · ${(stageMs[index] / 1000).toFixed(1)}s` }
]);
const totalSeconds = (stageMs.reduce((sum, ms) => sum + ms, 0) / 1000).toFixed(1);

/* ---- Release numbers: the oldest role is v1 ---- */
const releaseOf = (index: number) => `v${work.length - index}.0`;

/* ---- Command palette content ---- */
const groups: CommandGroup[] = [
