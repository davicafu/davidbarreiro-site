---
import SeoHead from '../../components/common/SeoHead.astro';
import { getAlternateLinks, getLocaleMetadata } from '../../lib/locale';

const seo = getLocaleMetadata('es');
const options = [
  {
    id: 'A',
    href: '/v3/a/',
    name: 'Documento técnico',
    idea: 'Tu portfolio como un design doc de ingeniería: resumen en lenguaje llano, ficha de estado con contacto y CV, secciones numeradas y tu método como «Figura 1».',
    tone: 'Claro, sobrio, serio. Habla el idioma de un tech lead sin perder al recruiter.',
    swatches: ['#f6f4ee', '#16181d', '#1b4fd8']
  },
  {
    id: 'B',
    href: '/v3/b/',
    name: 'Plano de metro',
    idea: 'Tu plataforma de datos y tu carrera dibujadas como líneas de metro: cada etapa y cada empresa es una estación.',
    tone: 'Luminoso, gráfico, muy legible. El diagrama es la portada.',
    swatches: ['#ffffff', '#1a1a1a', '#e2231a', '#0072ce', '#00a651']
  },
  {
    id: 'C',
    href: '/v3/c/',
    name: 'Registro continuo',
    idea: 'Papel milimetrado de registrador: tu trayectoria como una señal continua en el tiempo y tu método como canales de la plumilla.',
    tone: 'Técnico y cálido, con carácter de laboratorio. El streaming hecho papel.',
    swatches: ['#f4f1e8', '#c9d6c2', '#1d2a24', '#c8372d', '#1f4f9c']
  }
];
---

<html lang="es">
  <head>
    <SeoHead
      title={`Opciones de rediseño · ${seo.title}`}
      description={seo.description}
      canonical={seo.canonical}
      ogLocale={seo.ogLocale}
      ogLocaleAlternate={seo.ogLocaleAlternate}
      ogTitle={seo.ogTitle}
      ogDescription={seo.ogDescription}
      alternates={getAlternateLinks()}
      noindex
    />
    <style>
      :root {
        color-scheme: light;
      }
      body {
        margin: 0;
        background: #f3f3f1;
        color: #161616;
        font:
          16px/1.55 system-ui,
          -apple-system,
          'Segoe UI',
          sans-serif;
      }
      main {
        max-width: 64rem;
        margin: 0 auto;
        padding: clamp(2rem, 6vw, 4rem) 1rem 4rem;
      }
      h1 {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        line-height: 1.15;
        margin: 0 0 0.75rem;
        letter-spacing: -0.02em;
      }
      .intro {
        max-width: 60ch;
        color: #4a4a4a;
        margin: 0 0 2.5rem;
      }
      ol {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1rem;
      }
      li a {
        display: grid;
        grid-template-columns: 3rem 1fr;
        gap: 0.25rem 1.25rem;
        padding: 1.5rem;
        border: 1px solid #d6d6d2;
        border-radius: 0.75rem;
        background: #fff;
        color: inherit;
        text-decoration: none;
      }
      li a:hover {
        border-color: #161616;
      }
      li a:focus-visible {
        outline: 2px solid #1b4fd8;
        outline-offset: 3px;
      }
      .letter {
        grid-row: span 3;
        font-size: 2rem;
        font-weight: 800;
      }
      h2 {
        margin: 0;
        font-size: 1.25rem;
      }
      p {
        margin: 0;
      }
      .tone {
        color: #4a4a4a;
      }
      .swatches {
        display: flex;
        gap: 0.375rem;
        margin-top: 0.5rem;
      }
      .swatches span {
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 0.25rem;
        border: 1px solid rgb(0 0 0 / 0.15);
      }
      .also {
        margin-top: 2.5rem;
        color: #4a4a4a;
      }
      .also a {
        color: #1b4fd8;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Tres opciones de rediseño</h1>
      <p class="intro">
        Vistas previas con tus datos reales de <code>resume.json</code>: portada, experiencia, método,
        proyectos y contacto. Elige una y la completo con todas las funcionalidades de la web actual (idiomas,
        filtros, gráficos interactivos, descarga de CV).
      </p>
      <ol>
        {
          options.map((option) => (
            <li>
              <a href={option.href}>
                <span class="letter" aria-hidden="true">
                  {option.id}
                </span>
                <h2>
                  Opción {option.id} · {option.name}
                </h2>
                <p>{option.idea}</p>
                <p class="tone">{option.tone}</p>
                <span class="swatches" aria-hidden="true">
                  {option.swatches.map((color) => (
                    <span style={`background:${color}`} />
                  ))}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="also">
        También: <a href="/es/v2/">la versión mejorada del diseño actual (/es/v2/)</a> · <a href="/es/"
          >la web actual</a
        >
      </p>
    </main>
  </body>
</html>
