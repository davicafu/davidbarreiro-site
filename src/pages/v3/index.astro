---
import SeoHead from '../../components/common/SeoHead.astro';
import { getAlternateLinks, getLocaleMetadata } from '../../lib/locale';

const seo = getLocaleMetadata('es');
const options = [
  {
    id: '1',
    href: '/es/v4/',
    en: '/v4/',
    name: 'Red de metro',
    idea: 'Tu perfil como una red de transporte: la línea de datos (cómo diseñas), la laboral y la de formación se cruzan en un mapa vivo con trenes. Cada estación se pulsa y la explica un panel de andén.',
    tone: 'Claro, gráfico y señalético. Schibsted Grotesk.',
    swatches: ['#f5f3ee', '#121212', '#e4002b', '#0a5ec2', '#00985f']
  },
  {
    id: '2',
    href: '/es/v5/',
    en: '/v5/',
    name: 'Flujo de eventos',
    idea: 'Tu trayectoria como un topic de Kafka: una consola reproduce en directo eventos reales de tu carrera (empleos, formación, certificaciones) y tu método es un pipeline con paquetes en movimiento.',
    tone: 'Oscuro y cálido, serif editorial con acento ámbar. Instrument Serif + Geist + JetBrains Mono.',
    swatches: ['#0f0d0b', '#f3ede4', '#ffb547', '#6fd6c2', '#b9a4ff']
  },
  {
    id: '3',
    href: '/es/v6/',
    en: '/v6/',
    name: 'Cartel suizo',
    idea: 'Un cartel de estilo tipográfico internacional que se compone al cargar: bloques de color, cifras gigantes y una retícula estricta. El método son bloques numerados que se despliegan.',
    tone: 'Claro, editorial y rotundo. Archivo con rojo, cobalto y ocre.',
    swatches: ['#f2efe6', '#111111', '#e0251b', '#1e43c8', '#e9a61c']
  },
  {
    id: '4',
    href: '/es/v7/',
    en: '/v7/',
    name: 'Ciudad isométrica',
    idea: 'Tu forma de diseñar plataformas como una maqueta de arquitectura: cada etapa es un edificio unido por un conducto de luz con paquetes en movimiento. La experiencia es un corte del edificio, una planta por empleo, y la formación son los cimientos.',
    tone: 'Cálido y arquitectónico, papel y hormigón con naranja señal. Bricolage Grotesque + IBM Plex Mono.',
    swatches: ['#efeae1', '#1d1b18', '#ff5a1f', '#2f5d7c', '#c9bfae']
  },
  {
    id: '5',
    href: '/es/v8/',
    en: '/v8/',
    name: 'Panel de instrumentos',
    idea: 'Tu web como un aparato de alta gama: una pantalla LCD con un selector giratorio, el método como módulos unidos por cables con un pulso que viaja, la trayectoria como un secuenciador por años y los proyectos como cartuchos que se filtran con teclas de canal.',
    tone: 'Industrial y preciso, aluminio claro con naranja vivo. Instrument Sans + Doto + Martian Mono.',
    swatches: ['#e4e2dc', '#f5f4f0', '#1b1c1e', '#ff5b1f', '#131416']
  }
];
---

<html lang="es">
  <head>
    <SeoHead
      title={`Opciones de rediseño · ${seo.title}`}
      description={seo.description}
      canonical={seo.canonical}
      ogLocale={seo.ogLocale}
      ogLocaleAlternate={seo.ogLocaleAlternate}
      ogTitle={seo.ogTitle}
      ogDescription={seo.ogDescription}
      alternates={getAlternateLinks()}
      noindex
    />
    <style>
      :root {
        color-scheme: light;
      }
      body {
        margin: 0;
        background: #f3f3f1;
        color: #161616;
        font:
          16px/1.55 system-ui,
          -apple-system,
          'Segoe UI',
          sans-serif;
      }
      main {
        max-width: 64rem;
        margin: 0 auto;
        padding: clamp(2rem, 6vw, 4rem) 1rem 4rem;
      }
      h1 {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        line-height: 1.15;
        margin: 0 0 0.75rem;
        letter-spacing: -0.02em;
      }
      .intro {
        max-width: 60ch;
        color: #4a4a4a;
        margin: 0 0 2.5rem;
      }
      ol {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1rem;
      }
      li a {
        display: grid;
        grid-template-columns: 3rem 1fr;
        gap: 0.25rem 1.25rem;
        padding: 1.5rem;
        border: 1px solid #d6d6d2;
        border-radius: 0.75rem;
        background: #fff;
        color: inherit;
        text-decoration: none;
      }
      li a:hover {
        border-color: #161616;
      }
      li a:focus-visible {
        outline: 2px solid #1b4fd8;
        outline-offset: 3px;
      }
      .letter {
        grid-row: span 3;
        font-size: 2rem;
        font-weight: 800;
      }
      h2 {
        margin: 0;
        font-size: 1.25rem;
      }
      p {
        margin: 0;
      }
      .tone {
        color: #4a4a4a;
      }
      .swatches {
        display: flex;
        gap: 0.375rem;
        margin-top: 0.5rem;
      }
      .swatches span {
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 0.25rem;
        border: 1px solid rgb(0 0 0 / 0.15);
      }
      .also {
        margin-top: 2.5rem;
        color: #4a4a4a;
      }
      .also a {
        color: #1b4fd8;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Cinco rediseños para comparar</h1>
      <p class="intro">
        Los cinco tienen todas las funcionalidades de la web actual: inglés y español, CV en tres versiones,
        filtro de proyectos, enlaces a repositorios, skills con certificaciones y contacto. Ábrelos en el
        móvil también.
      </p>
      <ol>
        {
          options.map((option) => (
            <li>
              <a href={option.href}>
                <span class="letter" aria-hidden="true">
                  {option.id}
                </span>
                <h2>
                  {option.id} · {option.name}
                </h2>
                <p>{option.idea}</p>
                <p class="tone">{option.tone}</p>
                <p class="tone">También en inglés: {option.en}</p>
                <span class="swatches" aria-hidden="true">
                  {option.swatches.map((color) => (
                    <span style={`background:${color}`} />
                  ))}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="also">
        Referencia: <a href="/es/">web actual</a>
      </p>
    </main>
  </body>
</html>
